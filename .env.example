# Brand3 local development environment.
#
# Copy to `.env` for local work:
#   cp .env.example .env
#
# Never commit `.env` or real secrets.

# Provider keys
FIRECRAWL_API_KEY=your-firecrawl-api-key-here
# Admite cualquier número de claves adicionales separadas por comas.
FIRECRAWL_API_KEYS=additional-firecrawl-key-1,additional-firecrawl-key-2
EXA_API_KEY=your-exa-api-key-here
# Admite cualquier número de claves adicionales separadas por comas.
EXA_API_KEYS=additional-exa-key-1,additional-exa-key-2
SEARCHAPI_API_KEY=your-searchapi-key-here
BRAND3_SEARCHAPI_VERTICAL_FALLBACK_ENABLED=false
BRAND3_SEARCHAPI_FALLBACK_INTENTS=news
HYPERBROWSER_API_KEY=your-hyperbrowser-api-key-here
BRAND3_HYPERBROWSER_ENABLED=false
BRAND3_GITHUB_PROOF_ENABLED=true
GITHUB_TOKEN=optional-github-token-for-higher-rate-limits

# Search Enrichment Lab provider keys.
# Lab-only: do not wire these into canonical Brand3 scoring, Brand Audit,
# Magnetism, Research Pack, or public API without an explicit promotion decision.
PARALLEL_API_KEY=your-parallel-api-key-here
TAVILY_API_KEY=your-tavily-api-key-here
LINKUP_API_KEY=your-linkup-api-key-here
BRAVE_SEARCH_API_KEY=your-brave-search-api-key-here
SERPAPI_API_KEY=your-serpapi-api-key-here
PERPLEXITY_API_KEY=your-perplexity-api-key-here

# Existing optional experimental provider keys used by older lab scripts.
CONTEXT_DEV_API_KEY=your-context-dev-api-key-here
TINYFISH_API_KEY=your-tinyfish-api-key-here

# LLM provider (OpenAI-compatible). Default: Google AI Studio + Gemini 3.1 Pro Preview.
# Get a key at https://aistudio.google.com/apikey.
# GEMINI_API_KEY / GOOGLE_API_KEY / OPENROUTER_API_KEY are accepted as fallbacks.
BRAND3_LLM_API_KEY=your-aistudio-key-here

# LLM model roles:
# default = standard scoring
# cheap = high-volume extraction / low-risk checks
# premium = final narrative / complex validation
# audit/client/SV9/Magnetism overrides default conservatively to the broader roles below
# vision = screenshot analysis
BRAND3_LLM_MODEL=gemini-3.1-flash-lite
BRAND3_LLM_CHEAP_MODEL=gemini-3.1-flash-lite
BRAND3_LLM_PREMIUM_MODEL=gemini-3.1-flash-lite
BRAND3_AUDIT_ANALYST_MODEL=gemini-3.1-flash-lite
BRAND3_CLIENT_TLDR_V2_MODEL=gemini-3.1-flash-lite
BRAND3_MAGNETISM_EXTRACTOR_MODEL=gemini-3.1-flash-lite
BRAND3_MAGNETISM_ANALYST_MODEL=gemini-3.1-flash-lite
BRAND3_MAGNETISM_SYSTEM_READING_MODEL=gemini-3.1-flash-lite
BRAND3_SV9_BASE_MODEL=gemini-3.1-flash-lite
BRAND3_SV9_REASONING_MODEL=gemini-3.1-flash-lite
BRAND3_SV9_EDITORIAL_MODEL=gemini-3.1-flash-lite
BRAND3_VISION_MODEL=gemini-2.5-flash
BRAND3_MAGNETISM_EXTRACTOR_WEB_CHAR_LIMIT=16000
BRAND3_MAGNETISM_RESEARCH_PACK_TLDR=true
BRAND3_BRAND_RESEARCH_GRAPH_PACK=true

# Screenshot capture provider:
# playwright = default local browser screenshot capture, no Firecrawl credits required
# firecrawl = optional legacy screenshot path
SCREENSHOT_PROVIDER=playwright
BRAND3_VISUAL_SCREENSHOT_TIMEOUT_SECONDS=60

# Local SQLite database. The default app path is data/brand3.sqlite3.
# Keep local DB files out of Git.
# BRAND3_DB_PATH=data/brand3.sqlite3

# B3S historical system of record (docker compose up -d db). The schema and
# importer are live; the web runner remains file-backed until controlled cutover.
B3S_DATABASE_URL=postgresql://b3s:b3s@localhost:5433/b3s

# Temporal evidence policy:
# observe  = classify only; the newest scan stays visible
# repeated = enforce the selected baseline only when a brand has 2+ scans
# all      = enforce for every history, including single scans
B3S_CANONICAL_ENFORCEMENT_MODE=observe

# Experimental longitudinal evidence memory:
# disabled = do not compute or persist the projection
# shadow   = persist/read proposals with no scoring or canonical-selection effect
B3S_EVIDENCE_LEDGER_MODE=disabled

# FastAPI/Jinja local app settings.
BRAND3_ENVIRONMENT=development
BRAND3_BASE_URL=http://127.0.0.1:8000
BRAND3_MAX_CONCURRENT_ANALYSES=2
BRAND3_ANALYSIS_TIMEOUT_SECONDS=600
BRAND3_RATE_LIMIT_ENABLED=true
BRAND3_RATE_LIMIT_PER_IP=5
BRAND3_RATE_LIMIT_WINDOW_HOURS=24
BRAND3_RATE_LIMIT_BYPASS_IPS=127.0.0.1,::1

# Team access. Use generated local-only values in `.env`.
BRAND3_TEAM_TOKEN=replace-with-local-team-token
BRAND3_COOKIE_SECRET=replace-with-at-least-32-random-characters
BRAND3_SCANNER_API_TOKEN=replace-with-local-scanner-api-token

# Optional override for the read-only Visual Signature artifact root.
# BRAND3_VISUAL_SIGNATURE_ROOT=examples/visual_signature

# Visual Signature scanner evidence runs with scanner executions by default.
# Set false only for runtime isolation/debugging; this does not affect scoring.
BRAND3_VISUAL_SIGNATURE_SCAN_ENABLED=true

# Skip Gemini Vision multimodal calls during Visual Signature runs.
# When true, falls back to local-only heuristics without touching the LLM.
# BRAND3_VISUAL_SIGNATURE_SKIP_MULTIMODAL=false

# Dedicated model for Visual Signature multimodal analysis (defaults to BRAND3_VISION_MODEL).
# BRAND3_VISUAL_SIGNATURE_MODEL=gemini-2.5-flash

# Per-call timeout in seconds for Visual Signature multimodal calls.
# 0 means fall back to the global BRAND3_LLM_CALL_TIMEOUT_SECONDS.
# BRAND3_VISUAL_SIGNATURE_TIMEOUT_SECONDS=0

# Override to use a different provider (e.g. OpenRouter):
# BRAND3_LLM_BASE_URL=https://openrouter.ai/api/v1
# BRAND3_LLM_MODEL=google/gemini-3.1-flash-lite
# BRAND3_LLM_CHEAP_MODEL=google/gemini-3.1-flash-lite
# BRAND3_LLM_PREMIUM_MODEL=google/gemini-3.1-flash-lite
# BRAND3_AUDIT_ANALYST_MODEL=google/gemini-3.1-flash-lite
# BRAND3_CLIENT_TLDR_V2_MODEL=google/gemini-3.1-flash-lite
# BRAND3_MAGNETISM_EXTRACTOR_MODEL=google/gemini-3.1-flash-lite
# BRAND3_MAGNETISM_ANALYST_MODEL=google/gemini-3.1-flash-lite
# BRAND3_MAGNETISM_SYSTEM_READING_MODEL=google/gemini-3.1-flash-lite
# BRAND3_SV9_BASE_MODEL=google/gemini-3.1-flash-lite
# BRAND3_SV9_REASONING_MODEL=google/gemini-3.1-flash-lite
# BRAND3_SV9_EDITORIAL_MODEL=google/gemini-3.1-flash-lite
# BRAND3_VISION_MODEL=google/gemini-2.5-flash
