{% extends "base.html.j2" %}
{% block title %}{{ report.brand_name }} · {{ report.score }} — B3S{% endblock %}
{% set coverage_chip = {
  "positive_evidence": ("ok", "con evidencia"),
  "implied_not_explicit": ("info", "implícito, no explícito"),
  "verified_absent": ("warn", "ausencia verificada"),
  "probable_absent": ("warn", "ausencia probable"),
  "insufficient_acquisition": ("bad", "adquisición insuficiente"),
} %}

{% macro component_card(component) %}
{% set primary = component.card.primary %}
{% set support = component.card.support %}
{% set drawer = component.drawer %}
{% set meta = component.card.meta %}
<section class="panel component-card {{ component.span_class }}{% if component.status != 'scored' %} component-card--muted{% endif %}" id="{{ component.key }}">
  <div class="card-head">
    <h2 class="card-title">{{ component.label }}</h2>
    <div class="card-actions">
      <span class="badge">{{ component.score }}/{{ component.scale or 10 }}</span>
      {% if meta.has_drawer %}
      <button type="button" class="icon-button" data-dialog-target="drawer-{{ component.key }}" aria-label="Abrir lectura de {{ component.label }}" title="Abrir lectura de {{ component.label }}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
      </button>
      {% endif %}
    </div>
  </div>

  {% if primary["items"] %}
  <p class="card-result card-result--terms">{{ primary["items"] | join(" · ") }}</p>
  {% elif primary.text %}
  <p class="card-result{% if primary.is_fallback %} muted{% endif %}">{{ primary.text }}</p>
  {% endif %}

  {% if support.show_on_card and (support.text or support["items"]) %}
    {% if support["items"] %}
    <p class="card-verdict card-verdict--terms">{{ support["items"] | join(" · ") }}</p>
    {% endif %}
    {% if support.text %}
    <p class="card-verdict">{{ support.text }}</p>
    {% endif %}
  {% endif %}

  {% set bq = component.card.brand_quote %}
  {% if bq and bq.snippet %}
  <p class="card-evidence"><em>“{{ bq.snippet | truncate(180) }}”</em>{% if bq.url %} · <a class="source-link" href="{{ bq.url }}" target="_blank" rel="noopener noreferrer">fuente</a>{% endif %}</p>
  {% endif %}

  {% if meta.has_drawer %}
  <dialog class="report-drawer" id="drawer-{{ component.key }}" aria-labelledby="drawer-title-{{ component.key }}">
    <div class="report-drawer-head">
      <div>
        <div class="report-drawer-kicker">{{ component.score }}/{{ component.scale or 10 }}</div>
        <h3 id="drawer-title-{{ component.key }}">{{ component.label }}</h3>
      </div>
      <form method="dialog">
        <button type="submit" class="icon-button" aria-label="Cerrar lectura">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </form>
    </div>

    <div class="report-drawer-stack">
      <section class="drawer-section">
        <h4>Resumen</h4>
        <div class="drawer-summary-line">
          <span class="badge">{{ component.score }}/{{ component.scale or 10 }}</span>
          <span class="muted">evaluado</span>
        </div>
        {% if drawer.summary.primary_text %}
        <p class="drawer-lead"><em>{{ drawer.summary.primary_text }}</em></p>
        {% else %}
        <p class="muted">(no detectado)</p>
        {% endif %}
      </section>

      {% if drawer.evidence %}
      <section class="drawer-section">
        <h4>Evidencia</h4>
        {% for item in drawer.evidence %}
        <div class="evidence">
          <div class="ref">{% if item.ref %}{{ item.ref }}{% else %}evidencia{% endif %}{% if item.url %} · <a class="source-link" href="{{ item.url }}" rel="noopener noreferrer" target="_blank">abrir fuente</a>{% endif %}</div>
          {% if item.snippet %}<div class="muted snippet">{{ item.snippet }}</div>{% endif %}
        </div>
        {% endfor %}
      </section>
      {% endif %}

      {% if drawer.evaluator_verdict %}
      <section class="drawer-section">
        <h4>Explicación</h4>
        <p>{{ drawer.evaluator_verdict }}</p>
      </section>
      {% endif %}

      {% if drawer.detected_basis and (drawer.detected_basis.text or drawer.detected_basis["items"]) %}
      <section class="drawer-section">
        <h4>Base detectada</h4>
        {% if drawer.detected_basis["items"] %}
        <p class="card-verdict card-verdict--terms">{{ drawer.detected_basis["items"] | join(" · ") }}</p>
        {% endif %}
        {% if drawer.detected_basis.text %}
        <p class="muted">{{ drawer.detected_basis.text }}</p>
        {% endif %}
      </section>
      {% endif %}

      {% if drawer.next_artifact %}
      <section class="drawer-section">
        <h4>Siguiente artefacto</h4>
        <p>{{ drawer.next_artifact }}</p>
      </section>
      {% endif %}

      {% if drawer.off_tiles %}
      <section class="drawer-section">
        <h4>Baldosas apagadas</h4>
        <p class="drawer-section-note">{{ drawer.off_tiles | length }} fallos detectados: plan de trabajo.</p>
        <div class="drawer-tiles">
          {% for tile in drawer.off_tiles %}
          <article class="drawer-tile is-off">
            <div class="drawer-tile-id">{{ tile.id }}</div>
            <div class="drawer-tile-body">
              <div class="drawer-tile-head">
                <strong>{{ tile.name }}</strong>
                <span class="chip bad">apagada</span>
              </div>
              {% if tile.motivo %}<p>{{ tile.motivo }}</p>{% endif %}
              {% if tile.contexto_requerido %}<p class="muted">aporta contexto: {{ tile.contexto_requerido }}</p>{% endif %}
              {% if tile.evidencia %}<p class="muted">“{{ tile.evidencia }}”</p>{% endif %}
            </div>
          </article>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      {% if drawer.blind_spots %}
      <section class="drawer-section">
        <h4>Puntos ciegos</h4>
        <p class="drawer-section-note">{{ drawer.blind_spots | length }} piezas de contexto pendientes.</p>
        <div class="drawer-tiles">
          {% for tile in drawer.blind_spots %}
          <article class="drawer-tile is-blind">
            <div class="drawer-tile-id">{{ tile.id }}</div>
            <div class="drawer-tile-body">
              <div class="drawer-tile-head">
                <strong>{{ tile.name }}</strong>
                <span class="chip warn">punto ciego</span>
              </div>
              {% if tile.motivo %}<p>{{ tile.motivo }}</p>{% endif %}
              {% if tile.contexto_requerido %}<p class="muted">aporta contexto: {{ tile.contexto_requerido }}</p>{% endif %}
              {% if tile.evidencia %}<p class="muted">“{{ tile.evidencia }}”</p>{% endif %}
            </div>
          </article>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      {% if drawer.summary.coverage_status and drawer.summary.coverage_status != "unknown" %}
      {% set chip = coverage_chip.get(drawer.summary.coverage_status, ("", drawer.summary.coverage_status)) %}
      <div class="drawer-meta"><span class="chip {{ chip[0] }}">{{ chip[1] }}</span></div>
      {% endif %}

    </div>
  </dialog>
  {% endif %}
</section>
{% endmacro %}
{% block main_class %}wide{% endblock %}
{% block content %}
<p><a href="/">← Todos los informes</a> · <a href="{{ report.export.brand_visual_url }}">Módulo visual</a> · <a href="{{ report.export.markdown_url }}">Markdown</a></p>

{% set score_width = report.score_width if report.score_width is not none else 0 %}
<div class="report-hero">
  <div class="report-hero-main">
    <h1 class="report-hero-title">{{ report.brand_name }}</h1>
    <a class="report-hero-url" href="{{ report.url }}" target="_blank" rel="noopener noreferrer">{{ report.url }}</a>
  </div>
  <div class="report-hero-metric">
    <div class="report-hero-label">{{ report.hero.score_label }}</div>
    <div class="report-hero-score">
      {{ report.score if report.score is not none else "—" }}<span>/100</span>
    </div>
    <div class="report-score-bar" aria-hidden="true">
      <span style="--score-width: {{ score_width }}%;"></span>
    </div>
    {% if report.hero.most_painful_gap.label %}
    <div class="report-hero-note">hueco: {{ report.hero.most_painful_gap.label }}</div>
    {% elif report.base_average is not none %}
    <div class="report-hero-note">media base {{ report.base_average }}</div>
    {% endif %}
  </div>
  <div class="report-hero-metric">
    <div class="report-hero-label">Margen inmediato</div>
    <div class="report-hero-score report-hero-score--gain">
      {% if report.hero.immediate_margin %}+{{ report.hero.immediate_margin }}{% else %}0{% endif %}<span> pts</span>
    </div>
    {% if report.hero.insufficient_evidence %}
    <div class="report-hero-note">sin evidencia suficiente: {{ report.hero.insufficient_evidence | join(", ") }}</div>
    {% elif report.hero.not_detected %}
    <div class="report-hero-note">faltan: {{ report.hero.not_detected | join(", ") }}</div>
    {% elif report.hero.most_painful_gap.label %}
    <div class="report-hero-note">siguiente foco: {{ report.hero.most_painful_gap.label }}</div>
    {% else %}
    <div class="report-hero-note">sin hueco inmediato</div>
    {% endif %}
  </div>
</div>

{% if report.hero.executive_reading %}
<section class="panel report-reading">
  <p>{{ report.hero.executive_reading }}</p>
</section>
{% endif %}

<div class="canvas">
{% for component in report.components %}
  {{ component_card(component) }}
{% endfor %}
</div>

<section class="acquisition-trace">
<h2>Trazabilidad de adquisición</h2>
{% if report.acquisition and report.acquisition.state in ['blocked', 'cancelled', 'degraded_approved'] %}
<div class="panel acquisition-panel">
  <div class="ref">acquisition_gate · <span class="chip {% if report.acquisition.state in ['blocked', 'cancelled'] %}bad{% elif report.acquisition.state in ['warning', 'degraded_approved'] %}warn{% else %}ok{% endif %}">{{ report.acquisition.state }}</span></div>
  {% if report.acquisition.user_decision %}
  <p class="muted">decision: <span class="mono">{{ report.acquisition.user_decision }}</span>{% if report.acquisition.decision_source %} · source: <span class="mono">{{ report.acquisition.decision_source }}</span>{% endif %}</p>
  {% endif %}
  {% for issue in report.acquisition.issues or [] %}
  <div class="evidence">
    <div class="ref"><span class="chip bad">{{ issue.source }}</span> {{ issue.code }} · {{ issue.status }}</div>
    <div class="muted snippet">{{ issue.message }}</div>
  </div>
  {% endfor %}
</div>
{% endif %}
{% if report.acquisition.artifacts %}
<div class="panel acquisition-panel">
  <div class="ref">capturas y artefactos</div>
  <div class="acquisition-artifacts">
  {% for artifact in report.acquisition.artifacts %}
  <div class="evidence">
    <div class="ref">
      <span class="chip {{ artifact.chip_class }}">{{ artifact.source }}</span>
      {{ artifact.kind }}{% if artifact.status %} · {{ artifact.status }}{% endif %}
    </div>
    <p><a href="{{ artifact.href }}" target="_blank" rel="noreferrer">{{ artifact.display_label }}</a></p>
  </div>
  {% endfor %}
  </div>
</div>
{% endif %}
<div class="acquisition-metrics">
  <div class="cell acquisition-metric"><div class="k">páginas propias</div><div class="v">{{ report.acquisition.metrics.owned_url_count }}</div></div>
  <div class="cell acquisition-metric"><div class="k">pruebas externas</div><div class="v">{{ report.acquisition.metrics.external_proof_count }}</div></div>
  <div class="cell acquisition-metric"><div class="k">intentos externos</div><div class="v">{{ report.acquisition.metrics.external_attempt_count }}</div></div>
  <div class="cell acquisition-metric"><div class="k">registros de ausencia</div><div class="v">{{ report.acquisition.metrics.absence_ref_count }}</div></div>
  <div class="cell acquisition-metric"><div class="k">registros de evidencia</div><div class="v">{{ report.acquisition.metrics.evidence_record_count }}</div></div>
</div>

{% if report.absences %}
<h3 class="acquisition-subhead">Miramos y no estaba</h3>
<ul class="plain">
  {% for absence in report.absences %}
  <li><span class="chip warn">{{ absence.block }}</span> <span class="muted">{{ absence.content }}</span></li>
  {% endfor %}
</ul>
{% endif %}

{% if report.attempts %}
<h3 class="acquisition-subhead">Intentos de adquisición externa</h3>
<ul class="plain">
  {% for attempt in report.attempts %}
  <li><span class="mono">{{ attempt.provider }}</span> <span class="chip">{{ attempt.status }}</span> <span class="muted">{{ attempt.detail }}</span></li>
  {% endfor %}
</ul>
{% endif %}

</section>
<p class="muted mono type-caption">
  report {{ report.id }} ·
  <span title="{{ report.build.commit_sha }}">build {{ report.build.commit_short }}</span>
</p>
{% endblock %}
