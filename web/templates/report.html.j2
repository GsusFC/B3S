{% extends "base.html.j2" %}
{% block title %}{{ report.brand_name }} · {{ report.score }} — B3S{% endblock %}
{% set coverage_chip = {
  "positive_evidence": ("ok", "con evidencia"),
  "implied_not_explicit": ("info", "implícito, no explícito"),
  "verified_absent": ("warn", "ausencia verificada"),
  "insufficient_acquisition": ("bad", "adquisición insuficiente"),
} %}
{% set component_card_layout = {
  "core_purpose": "component-card--half",
  "magnetism": "component-card--half",
  "value_proposition": "component-card--third",
  "personality": "component-card--third",
  "brand_idea": "component-card--third",
  "attributes": "component-card--half",
  "values": "component-card--half",
  "mission": "component-card--half",
  "vision": "component-card--half",
  "coherencia": "component-card--full",
} %}
{% block main_class %}wide{% endblock %}
{% block content %}
<p><a href="/">← Todos los informes</a></p>

{% set score_width = report.score if report.score is not none else 0 %}
<div class="report-hero">
  <div class="report-hero-main">
    <h1 class="report-hero-title">{{ report.brand_name }}</h1>
    <a class="report-hero-url" href="{{ report.url }}" target="_blank" rel="noopener noreferrer">{{ report.url }}</a>
  </div>
  <div class="report-hero-metric">
    <div class="report-hero-label">Brand3 Score</div>
    <div class="report-hero-score">
      {{ report.score if report.score is not none else "—" }}<span>/100</span>
    </div>
    <div class="report-score-bar" aria-hidden="true">
      <span style="--score-width: {{ score_width }}%;"></span>
    </div>
    {% if report.most_painful_gap_label %}
    <div class="report-hero-note">hueco: {{ report.most_painful_gap_label }}</div>
    {% elif report.base_average is not none %}
    <div class="report-hero-note">media base {{ report.base_average }}</div>
    {% endif %}
  </div>
  <div class="report-hero-metric">
    <div class="report-hero-label">Margen inmediato</div>
    <div class="report-hero-score report-hero-score--gain">
      {% if report.immediate_margin %}+{{ report.immediate_margin }}{% else %}0{% endif %}<span> pts</span>
    </div>
    {% if report.not_detected %}
    <div class="report-hero-note">faltan: {{ report.not_detected | join(", ") }}</div>
    {% elif report.most_painful_gap_label %}
    <div class="report-hero-note">siguiente foco: {{ report.most_painful_gap_label }}</div>
    {% else %}
    <div class="report-hero-note">sin hueco inmediato</div>
    {% endif %}
  </div>
</div>

<div class="canvas">
{% for component in report.components %}
{% set has_component_details = component.tiles or (component.block and (component.block.refs or component.block.rejected_content)) %}
<section class="panel component-card {{ component_card_layout.get(component.key, 'component-card--third') }}{% if component.status != 'scored' %} component-card--muted{% endif %}" id="{{ component.key }}">
  <div class="card-head">
    <h2 class="card-title">{{ component.label }}</h2>
    <div class="card-actions">
      <span class="badge">{{ component.score }}/{{ component.scale or 10 }}</span>
      {% if has_component_details %}
      <button type="button" class="icon-button" data-dialog-target="drawer-{{ component.key }}" aria-label="Abrir lectura de {{ component.label }}" title="Abrir lectura de {{ component.label }}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
      </button>
      {% endif %}
    </div>
  </div>

  {% if component.resumen %}
  <p class="card-result">{{ component.resumen }}</p>
  {% elif component.status == "not_detected" and component.level_zero %}
  <p class="card-result muted">{{ component.level_zero }}</p>
  {% endif %}

  {% if component.veredicto %}
  <p class="card-verdict">{{ component.veredicto }}</p>
  {% endif %}

  {% if has_component_details %}
  <dialog class="report-drawer" id="drawer-{{ component.key }}" aria-labelledby="drawer-title-{{ component.key }}">
    <div class="report-drawer-head">
      <div>
        <div class="report-drawer-kicker">{{ component.score }}/{{ component.scale or 10 }}</div>
        <h3 id="drawer-title-{{ component.key }}">{{ component.label }}</h3>
      </div>
      <form method="dialog">
        <button type="submit" class="icon-button" aria-label="Cerrar lectura">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </form>
    </div>

    <div class="report-drawer-stack">
      <section class="drawer-section">
        <h4>Resumen</h4>
        <div class="drawer-summary-line">
          <span class="badge">{{ component.score }}/{{ component.scale or 10 }}</span>
          <span class="muted">evaluado</span>
        </div>
        {% if component.resumen %}
        <p>{{ component.resumen }}</p>
        {% elif component.status == "not_detected" and component.level_zero %}
        <p>{{ component.level_zero }}</p>
        {% else %}
        <p class="muted">(no detectado)</p>
        {% endif %}
      </section>

      {% if component.tiles %}
      <section class="drawer-section">
        <h4>Baldosas</h4>
        <p class="drawer-section-note">{{ component.tiles | length }} fallos o puntos ciegos detectados.</p>
        <div class="drawer-tiles">
          {% for tile in component.tiles %}
          <article class="drawer-tile {{ 'is-off' if tile.estado == 'no' else 'is-blind' }}">
            <div class="drawer-tile-id">{{ tile.id }}</div>
            <div class="drawer-tile-body">
              <div class="drawer-tile-head">
                <strong>{{ tile.name }}</strong>
                <span class="chip {{ 'bad' if tile.estado == 'no' else 'warn' }}">{{ "apagada" if tile.estado == "no" else "punto ciego" }}</span>
              </div>
              {% if tile.motivo %}<p>{{ tile.motivo }}</p>{% endif %}
              {% if tile.evidencia %}<p class="muted">“{{ tile.evidencia }}”</p>{% endif %}
            </div>
          </article>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      {% if component.veredicto %}
      <section class="drawer-section">
        <h4>V9</h4>
        <p>{{ component.veredicto }}</p>
      </section>
      {% endif %}

      {% if component.block and component.block.coverage_status %}
      {% set chip = coverage_chip.get(component.block.coverage_status, ("", component.block.coverage_status)) %}
      <div class="drawer-meta"><span class="chip {{ chip[0] }}">{{ chip[1] }}</span></div>
      {% endif %}

      {% if component.block %}
      {% set block = component.block %}
      {% if block.rejected_content and not block.detected %}
      <section class="drawer-section">
        <h4>Filtro</h4>
        <p class="muted">{{ block.rejected_content }}</p>
      </section>
      {% endif %}
      {% if block.refs %}
      <section class="drawer-section">
        <h4>Evidencia</h4>
      {% for item in block.refs %}
      <div class="evidence">
        <div class="ref">{{ item.ref }}{% if item.url %} · <a href="{{ item.url }}" rel="noopener noreferrer">{{ item.url }}</a>{% endif %}</div>
        <div class="muted" style="font-size:13px">{{ item.snippet }}</div>
      </div>
      {% endfor %}
      </section>
      {% endif %}
      {% endif %}
    </div>
  </dialog>
  {% endif %}
</section>
{% endfor %}
</div>

<h2>Trazabilidad de adquisición</h2>
{% if report.acquisition_gate %}
<div class="panel" style="margin-bottom:12px">
  <div class="ref">acquisition_gate · <span class="chip {% if report.acquisition_gate.state in ['blocked', 'cancelled'] %}bad{% elif report.acquisition_gate.state in ['warning', 'degraded_approved'] %}warn{% else %}ok{% endif %}">{{ report.acquisition_gate.state }}</span></div>
  {% if report.acquisition_gate.user_decision %}
  <p class="muted">decision: <span class="mono">{{ report.acquisition_gate.user_decision }}</span>{% if report.acquisition_gate.decision_source %} · source: <span class="mono">{{ report.acquisition_gate.decision_source }}</span>{% endif %}</p>
  {% endif %}
  {% for issue in report.acquisition_gate.issues or [] %}
  <div class="evidence">
    <div class="ref"><span class="chip bad">{{ issue.source }}</span> {{ issue.code }} · {{ issue.status }}</div>
    <div class="muted" style="font-size:13px">{{ issue.message }}{% if issue.detail %} · {{ issue.detail }}{% endif %}</div>
  </div>
  {% endfor %}
  {% for warning in report.acquisition_gate.warnings or [] %}
  <div class="evidence">
    <div class="ref"><span class="chip warn">{{ warning.source }}</span> {{ warning.code }} · {{ warning.status }}</div>
    <div class="muted" style="font-size:13px">{{ warning.message }}{% if warning.detail %} · {{ warning.detail }}{% endif %}</div>
  </div>
  {% endfor %}
</div>
{% endif %}
<div class="grid">
  <div class="cell"><div class="k">páginas propias</div><div class="v">{{ report.coverage_acquisition.owned_url_count }}</div></div>
  <div class="cell"><div class="k">pruebas externas</div><div class="v">{{ report.coverage_acquisition.external_proof_count }}</div></div>
  <div class="cell"><div class="k">intentos externos</div><div class="v">{{ report.coverage_acquisition.external_attempt_count }}</div></div>
  <div class="cell"><div class="k">registros de ausencia</div><div class="v">{{ report.coverage_acquisition.absence_ref_count }}</div></div>
  <div class="cell"><div class="k">registros de evidencia</div><div class="v">{{ report.coverage_acquisition.evidence_record_count }}</div></div>
</div>

{% if report.absences %}
<h3 style="font-size:14px">Miramos y no estaba</h3>
<ul class="plain">
  {% for absence in report.absences %}
  <li><span class="chip warn">{{ absence.block }}</span> <span class="muted">{{ absence.content }}</span></li>
  {% endfor %}
</ul>
{% endif %}

{% if report.attempts %}
<h3 style="font-size:14px">Intentos de adquisición externa</h3>
<ul class="plain">
  {% for attempt in report.attempts %}
  <li><span class="mono">{{ attempt.provider }}</span> <span class="chip">{{ attempt.status }}</span> <span class="muted">{{ attempt.detail }}</span></li>
  {% endfor %}
</ul>
{% endif %}

{% if report.limitations %}
<details style="margin-top:16px">
  <summary class="muted" style="cursor:pointer">Limitations ({{ report.limitations | length }})</summary>
  <ul class="plain mono" style="font-size:13px">
    {% for limitation in report.limitations %}<li>{{ limitation }}</li>{% endfor %}
  </ul>
</details>
{% endif %}
{% endblock %}
