{% extends "base.html.j2" %}
{% block title %}{{ report.brand_name }}{% if report.score_publication.publishable %} · {{ report.score }}{% else %} · score retenido{% endif %} — B3S{% endblock %}
{% set coverage_chip = {
  "positive_evidence": ("ok", "con evidencia"),
  "implied_not_explicit": ("info", "implícito, no explícito"),
  "verified_absent": ("warn", "ausencia verificada"),
  "probable_absent": ("warn", "ausencia probable"),
  "insufficient_acquisition": ("bad", "adquisición insuficiente"),
} %}

{% macro component_card(component, score_publication) %}
{% set primary = component.card.primary %}
{% set support = component.card.support %}
{% set drawer = component.drawer %}
{% set meta = component.card.meta %}
<section class="panel component-card {{ component.span_class }}{% if component.status != 'scored' %} component-card--muted{% endif %}" id="{{ component.key }}">
  <div class="card-head">
    <h2 class="card-title">{{ component.label }}</h2>
    <div class="card-actions">
      <span class="badge">{% if score_publication.publishable %}{{ component.score }}{% else %}—{% endif %}/{{ component.scale or 10 }}</span>
      {% if meta.has_drawer %}
      <button type="button" class="icon-button" data-dialog-target="drawer-{{ component.key }}" aria-label="Abrir lectura de {{ component.label }}" title="Abrir lectura de {{ component.label }}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
      </button>
      {% endif %}
    </div>
  </div>

  {% if primary["items"] %}
  <p class="card-result card-result--terms"><span class="chip info">interpretación</span> {{ primary["items"] | join(" · ") }}</p>
  {% elif primary.text %}
  <p class="card-result{% if primary.is_fallback %} muted{% endif %}"><span class="chip info">interpretación</span> {{ primary.text }}</p>
  {% endif %}

  {% if support.show_on_card and (support.text or support["items"]) %}
    {% if support["items"] %}
    <p class="card-verdict card-verdict--terms">{{ support["items"] | join(" · ") }}</p>
    {% endif %}
    {% if support.text %}
    <p class="card-verdict">{{ support.text }}</p>
    {% endif %}
  {% endif %}

  {% set bq = component.card.brand_quote %}
  {% if bq and bq.snippet %}
  <p class="card-evidence"><span class="chip ok">cita literal</span> <em>“{{ bq.snippet | truncate(180) }}”</em>{% if bq.url %} · <a class="source-link" href="{{ bq.url }}" target="_blank" rel="noopener noreferrer">fuente</a>{% endif %}</p>
  {% endif %}

  {% if drawer.summary.coverage_status and drawer.summary.coverage_status in coverage_chip %}
  {% set component_coverage_chip = coverage_chip.get(drawer.summary.coverage_status) %}
  <p class="card-evidence"><span class="chip {{ component_coverage_chip[0] }}">{{ component_coverage_chip[1] }}</span></p>
  {% endif %}

  {% set hierarchy = component.card.surface_hierarchy %}
  {% if hierarchy.warns_hidden_content %}
  <p class="card-evidence"><span class="chip warn">jerarquía</span> {{ hierarchy.label }}{% if hierarchy.counts.sitemap_only %} · {{ hierarchy.counts.sitemap_only }} página{% if hierarchy.counts.sitemap_only != 1 %}s{% endif %}{% endif %}</p>
  {% endif %}

  {% if meta.has_drawer %}
  <dialog class="report-drawer" id="drawer-{{ component.key }}" aria-labelledby="drawer-title-{{ component.key }}">
    <div class="report-drawer-head">
      <div>
        <div class="report-drawer-kicker">{% if score_publication.publishable %}{{ component.score }}{% else %}—{% endif %}/{{ component.scale or 10 }}</div>
        <h3 id="drawer-title-{{ component.key }}">{{ component.label }}</h3>
      </div>
      <form method="dialog">
        <button type="submit" class="icon-button" aria-label="Cerrar lectura">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </form>
    </div>

    <div class="report-drawer-stack">
      <section class="drawer-section">
        <h4>Resumen</h4>
        <div class="drawer-summary-line">
          <span class="badge">{% if score_publication.publishable %}{{ component.score }}{% else %}—{% endif %}/{{ component.scale or 10 }}</span>
          <span class="muted">{% if score_publication.publishable %}evaluado{% else %}score retenido{% endif %}</span>
        </div>
        {% if drawer.summary.primary_text %}
        <p class="drawer-lead"><span class="chip info">interpretación</span> <em>{{ drawer.summary.primary_text }}</em></p>
        {% else %}
        <p class="muted">(no detectado)</p>
        {% endif %}
      </section>

      {% if drawer.evidence %}
      <section class="drawer-section">
        <h4>Evidencia literal del snapshot</h4>
        {% for item in drawer.evidence %}
        <div class="evidence">
          <div class="ref">{% if item.ref %}{{ item.ref }}{% else %}evidencia{% endif %}{% if item.url %} · <a class="source-link" href="{{ item.url }}" rel="noopener noreferrer" target="_blank">abrir fuente</a>{% endif %}</div>
          {% if item.snippet %}<div class="muted snippet">{{ item.snippet }}</div>{% endif %}
        </div>
        {% endfor %}
      </section>
      {% endif %}

      {% if drawer.surface_hierarchy.status %}
      <section class="drawer-section">
        <h4>Presencia y jerarquía</h4>
        <p>{{ drawer.surface_hierarchy.label }}.</p>
        {% if drawer.surface_hierarchy.owned_surfaces %}
        <ul class="plain">
          {% for surface in drawer.surface_hierarchy.owned_surfaces %}
          <li><span class="chip{% if surface.navigation_status == 'sitemap_only' %} warn{% endif %}">{{ surface.navigation_status }}</span> <a class="source-link" href="{{ surface.url }}" target="_blank" rel="noopener noreferrer">{{ surface.url }}</a>{% if not surface.captured %} <span class="muted">· obtenida por otra fuente</span>{% endif %}</li>
          {% endfor %}
        </ul>
        {% endif %}
      </section>
      {% endif %}

      {% if drawer.evaluator_verdict %}
      <section class="drawer-section">
        <h4>Explicación</h4>
        <p>{{ drawer.evaluator_verdict }}</p>
      </section>
      {% endif %}

      {% if drawer.detected_basis and (drawer.detected_basis.text or drawer.detected_basis["items"]) %}
      <section class="drawer-section">
        <h4>Interpretación de la evidencia</h4>
        {% if drawer.detected_basis["items"] %}
        <p class="card-verdict card-verdict--terms">{{ drawer.detected_basis["items"] | join(" · ") }}</p>
        {% endif %}
        {% if drawer.detected_basis.text %}
        <p class="muted">{{ drawer.detected_basis.text }}</p>
        {% endif %}
      </section>
      {% endif %}

      {% if drawer.next_artifact %}
      <section class="drawer-section">
        <h4>Siguiente artefacto</h4>
        <p>{{ drawer.next_artifact }}</p>
      </section>
      {% endif %}

      {% if drawer.off_tiles %}
      <section class="drawer-section">
        <h4>Baldosas apagadas</h4>
        <p class="drawer-section-note">{{ drawer.off_tiles | length }} fallos detectados: plan de trabajo.</p>
        <div class="drawer-tiles">
          {% for tile in drawer.off_tiles %}
          <article class="drawer-tile is-off">
            <div class="drawer-tile-id">{{ tile.id }}</div>
            <div class="drawer-tile-body">
              <div class="drawer-tile-head">
                <strong>{{ tile.name }}</strong>
                <span class="chip bad">apagada</span>
              </div>
              {% if tile.motivo %}<p>{{ tile.motivo }}</p>{% endif %}
              {% if tile.contexto_requerido %}<p class="muted">aporta contexto: {{ tile.contexto_requerido }}</p>{% endif %}
              {% if tile.evidencia %}<p class="muted">“{{ tile.evidencia }}”</p>{% endif %}
            </div>
          </article>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      {% if drawer.blind_spots %}
      <section class="drawer-section">
        <h4>Puntos ciegos</h4>
        <p class="drawer-section-note">{{ drawer.blind_spots | length }} piezas de contexto pendientes.</p>
        <div class="drawer-tiles">
          {% for tile in drawer.blind_spots %}
          <article class="drawer-tile is-blind">
            <div class="drawer-tile-id">{{ tile.id }}</div>
            <div class="drawer-tile-body">
              <div class="drawer-tile-head">
                <strong>{{ tile.name }}</strong>
                <span class="chip warn">punto ciego</span>
              </div>
              {% if tile.motivo %}<p>{{ tile.motivo }}</p>{% endif %}
              {% if tile.contexto_requerido %}<p class="muted">aporta contexto: {{ tile.contexto_requerido }}</p>{% endif %}
              {% if tile.evidencia %}<p class="muted">“{{ tile.evidencia }}”</p>{% endif %}
            </div>
          </article>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      {% if drawer.summary.coverage_status and drawer.summary.coverage_status != "unknown" %}
      {% set chip = coverage_chip.get(drawer.summary.coverage_status, ("", drawer.summary.coverage_status)) %}
      <div class="drawer-meta"><span class="chip {{ chip[0] }}">{{ chip[1] }}</span></div>
      {% endif %}

    </div>
  </dialog>
  {% endif %}
</section>
{% endmacro %}
{% block main_class %}wide{% endblock %}
{% block content %}
<div class="report-actions">
  <p><a href="/">← Todos los informes</a> · <a href="{{ report.export.brand_visual_url }}">Módulo visual</a> · <a href="{{ report.export.markdown_url }}">Markdown</a></p>
  <form method="post" action="/scan">
    <input type="hidden" name="url" value="{{ report.url }}">
    <input type="hidden" name="brand_name" value="{{ report.brand_name }}">
    <button type="submit">Reescanear</button>
  </form>
</div>

{% set score_width = report.score_width if report.score_width is not none else 0 %}
<div class="report-hero">
  <div class="report-hero-main">
    <h1 class="report-hero-title">{{ report.brand_name }}</h1>
    <a class="report-hero-url" href="{{ report.url }}" target="_blank" rel="noopener noreferrer">{{ report.url }}</a>
    {% if report.created_at_display %}
    <div class="muted mono">Escaneado: {{ report.created_at_display }}</div>
    {% endif %}
  </div>
  <div class="report-hero-metric">
    <div class="report-hero-label">{{ report.score_publication.label }}</div>
    <div class="report-hero-score">
      {% if report.score_publication.publishable %}{{ report.score if report.score is not none else "—" }}{% else %}—{% endif %}<span>/100</span>
    </div>
    <div class="report-score-bar" aria-hidden="true">
      <span style="--score-width: {{ score_width }}%;"></span>
    </div>
    {% if not report.score_publication.publishable %}
    <div class="report-hero-note">{{ report.score_publication.reason }}</div>
    {% elif report.hero.most_painful_gap.label %}
    <div class="report-hero-note">hueco: {{ report.hero.most_painful_gap.label }}</div>
    {% elif report.base_average is not none %}
    <div class="report-hero-note">media base {{ report.base_average }}</div>
    {% endif %}
  </div>
  <div class="report-hero-metric">
    <div class="report-hero-label">{% if report.score_publication.publishable %}Margen inmediato{% else %}Comparativa{% endif %}</div>
    <div class="report-hero-score report-hero-score--gain">
      {% if report.score_publication.publishable %}{% if report.hero.immediate_margin %}+{{ report.hero.immediate_margin }}{% else %}0{% endif %}<span> pts</span>{% else %}—{% endif %}
    </div>
    {% if not report.score_publication.publishable %}
    <div class="report-hero-note">consulta abajo el diagnóstico de estabilidad</div>
    {% elif report.hero.insufficient_evidence %}
    <div class="report-hero-note">sin evidencia suficiente: {{ report.hero.insufficient_evidence | join(", ") }}</div>
    {% elif report.hero.not_detected %}
    <div class="report-hero-note">faltan: {{ report.hero.not_detected | join(", ") }}</div>
    {% elif report.hero.most_painful_gap.label %}
    <div class="report-hero-note">siguiente foco: {{ report.hero.most_painful_gap.label }}</div>
    {% else %}
    <div class="report-hero-note">sin hueco inmediato</div>
    {% endif %}
  </div>
</div>

{% if report.stability.show %}
<section class="panel report-reading">
  <div class="ref"><span class="chip {{ report.stability.chip_class }}">{{ report.stability.canonical_status }}</span> {{ report.stability.title }}</div>
  <p>{{ report.stability.message }}</p>
  {% if report.stability.baseline_report_id %}
  <p class="muted">Baseline: <span class="mono">{{ report.stability.baseline_report_id }}</span></p>
  {% endif %}
  {% if report.stability.changed_components %}
  <ul class="plain">
    {% for changed in report.stability.changed_components %}
    <li><strong>{{ changed.label }}</strong>: {{ changed.score_before }} → {{ changed.score_after }}{% if changed.changed_tiles %} <span class="muted">· baldosas {{ changed.changed_tiles | join(", ") }}</span>{% endif %}</li>
    {% endfor %}
  </ul>
  {% endif %}
</section>
{% endif %}

{% if report.hero.executive_reading %}
<section class="panel report-reading">
  <p>{{ report.hero.executive_reading }}</p>
</section>
{% endif %}

<div class="canvas">
{% for component in report.components %}
  {{ component_card(component, report.score_publication) }}
{% endfor %}
</div>

<section class="acquisition-trace">
<h2>Trazabilidad de adquisición</h2>
{% if report.acquisition and report.acquisition.state in ['blocked', 'cancelled', 'degraded_approved'] %}
<div class="panel acquisition-panel">
  <div class="ref">acquisition_gate · <span class="chip {% if report.acquisition.state in ['blocked', 'cancelled'] %}bad{% elif report.acquisition.state in ['warning', 'degraded_approved'] %}warn{% else %}ok{% endif %}">{{ report.acquisition.state }}</span></div>
  {% if report.acquisition.user_decision %}
  <p class="muted">decision: <span class="mono">{{ report.acquisition.user_decision }}</span>{% if report.acquisition.decision_source %} · source: <span class="mono">{{ report.acquisition.decision_source }}</span>{% endif %}</p>
  {% endif %}
  {% for issue in report.acquisition.issues or [] %}
  <div class="evidence">
    <div class="ref"><span class="chip bad">{{ issue.source }}</span> {{ issue.code }} · {{ issue.status }}</div>
    <div class="muted snippet">{{ issue.message }}</div>
  </div>
  {% endfor %}
</div>
{% endif %}
{% if report.acquisition.artifacts %}
<div class="panel acquisition-panel">
  <div class="ref">capturas y artefactos</div>
  <div class="acquisition-artifacts">
  {% for artifact in report.acquisition.artifacts %}
  <div class="evidence">
    <div class="ref">
      <span class="chip {{ artifact.chip_class }}">{{ artifact.source }}</span>
      {{ artifact.kind }}{% if artifact.status %} · {{ artifact.status }}{% endif %}
    </div>
    <p><a href="{{ artifact.href }}" target="_blank" rel="noreferrer">{{ artifact.display_label }}</a></p>
  </div>
  {% endfor %}
  </div>
</div>
{% endif %}
<div class="acquisition-metrics">
  <div class="cell acquisition-metric"><div class="k">páginas propias capturadas</div><div class="v">{{ report.acquisition.owned_pages.coverage_label }}</div>{% if report.acquisition.owned_pages.known_page_count %}<div class="muted">{{ report.acquisition.owned_pages.coverage_percent }}% de las conocidas</div>{% endif %}</div>
  {% if report.acquisition.owned_pages.eligible_page_count %}
  <div class="cell acquisition-metric"><div class="k">páginas elegibles capturadas</div><div class="v">{{ report.acquisition.owned_pages.eligible_coverage_label }}</div><div class="muted">{{ report.acquisition.owned_pages.eligible_coverage_percent }}% del alcance estratégico</div></div>
  {% endif %}
  {% if report.acquisition.owned_pages.content_sampling.sampling_record_count %}
  <div class="cell acquisition-metric"><div class="k">contenido conservado</div><div class="v">{{ report.acquisition.owned_pages.content_sampling.retained_chunk_count }} de {{ report.acquisition.owned_pages.content_sampling.available_chunk_count }}</div><div class="muted">en {{ report.acquisition.owned_pages.content_sampling.affected_url_count }} páginas con muestreo parcial</div></div>
  {% endif %}
  <div class="cell acquisition-metric"><div class="k">pruebas externas</div><div class="v">{{ report.acquisition.metrics.external_proof_count }}</div></div>
  <div class="cell acquisition-metric"><div class="k">intentos externos</div><div class="v">{{ report.acquisition.metrics.external_attempt_count }}</div></div>
  <div class="cell acquisition-metric"><div class="k">registros de ausencia</div><div class="v">{{ report.acquisition.metrics.absence_ref_count }}</div></div>
  <div class="cell acquisition-metric"><div class="k">registros de evidencia</div><div class="v">{{ report.acquisition.metrics.evidence_record_count }}</div></div>
  {% if report.acquisition.owned_pages.language_detection.evaluated_page_count %}
  <div class="cell acquisition-metric"><div class="k">idiomas observados</div><div class="v">{{ report.acquisition.owned_pages.language_detection.summary }}</div></div>
  {% endif %}
</div>

{% if report.acquisition.owned_pages.visited_pages or report.acquisition.owned_pages.not_visited_pages %}
<details class="panel acquisition-panel">
  <summary>Cobertura propia · {{ report.acquisition.owned_pages.coverage_label }} páginas capturadas</summary>
  {% if report.acquisition.owned_pages.selection_version %}
  <p class="muted">Política: <span class="mono">{{ report.acquisition.owned_pages.selection_version }}</span>{% if report.acquisition.owned_pages.latest_lastmod %} · último <span class="mono">lastmod</span> observado: {{ report.acquisition.owned_pages.latest_lastmod }}{% endif %}</p>
  {% endif %}
  {% if report.acquisition.owned_pages.latest_lastmod_newer_than_scan %}
  <p><span class="chip warn">contenido posterior al scan</span> El sitemap declara contenido modificado después de este análisis. Conviene reescanear.</p>
  {% endif %}
  {% if report.acquisition.owned_pages.language_detection.mixed_language_site %}
  <p><span class="chip warn">mezcla de idiomas</span> Las páginas capturadas cambian de idioma dentro del mismo dominio{% if report.acquisition.owned_pages.language_detection.declared_mismatch_count %}; {{ report.acquisition.owned_pages.language_detection.declared_mismatch_count }} no coincide{% if report.acquisition.owned_pages.language_detection.declared_mismatch_count != 1 %}n{% endif %} con el idioma declarado en HTML{% endif %}.</p>
  {% endif %}
  {% if report.acquisition.owned_pages.content_sampling.sampling_record_count %}
  <p><span class="chip warn">contenido muestreado</span> Capturar una URL no implica conservar todo su texto: se omitieron {{ report.acquisition.owned_pages.content_sampling.omitted_chunk_count }} fragmentos después de priorizar las secciones estratégicas.</p>
  <details>
    <summary>Superficies con contenido parcial</summary>
    <ul class="plain">
      {% for surface in report.acquisition.owned_pages.content_sampling.surfaces %}
      <li><span class="chip warn">{{ surface.retained_chunk_count }}/{{ surface.available_chunk_count }} fragmentos</span> {% if surface.url %}<a href="{{ surface.url }}" target="_blank" rel="noopener noreferrer">{{ surface.url }}</a>{% else %}<span class="mono">{{ surface.ref }}</span>{% endif %}</li>
      {% endfor %}
    </ul>
  </details>
  {% endif %}
  {% if report.acquisition.owned_pages.visited_pages %}
  <h3 class="acquisition-subhead">Visitadas</h3>
  <ul class="plain">
    {% for page in report.acquisition.owned_pages.visited_pages %}
    <li><span class="chip {% if page.status == 'captured' %}ok{% else %}warn{% endif %}">{{ page.status or "visitada" }}</span> <a href="{{ page.url }}" target="_blank" rel="noopener noreferrer">{{ page.url }}</a>{% if page.navigation_status %} <span class="muted">· {{ page.navigation_status }}</span>{% endif %}{% if page.observed_language_label %} <span class="muted">· idioma {{ page.observed_language_label }} ({{ page.language_confidence }})</span>{% endif %}{% if page.declared_language_mismatch %} <span class="chip warn">HTML {{ page.declared_language }}</span>{% endif %}</li>
    {% endfor %}
  </ul>
  {% endif %}
  {% if report.acquisition.owned_pages.not_visited_pages %}
  <h3 class="acquisition-subhead">Conocidas y no visitadas</h3>
  <ul class="plain">
    {% for page in report.acquisition.owned_pages.not_visited_pages %}
    <li><span class="chip">{{ page.reason or "not_visited" }}</span> <a href="{{ page.url }}" target="_blank" rel="noopener noreferrer">{{ page.url }}</a>{% if page.navigation_status %} <span class="muted">· {{ page.navigation_status }}</span>{% endif %}</li>
    {% endfor %}
  </ul>
  {% endif %}
</details>
{% endif %}

{% if report.absences %}
<h3 class="acquisition-subhead">Miramos y no estaba</h3>
<ul class="plain">
  {% for absence in report.absences %}
  <li><span class="chip warn">{{ absence.block }}</span> <span class="muted">{{ absence.content }}</span></li>
  {% endfor %}
</ul>
{% endif %}

{% if report.attempts %}
<h3 class="acquisition-subhead">Intentos de adquisición externa</h3>
<ul class="plain">
  {% for attempt in report.attempts %}
  <li><span class="mono">{{ attempt.provider }}</span> <span class="chip">{{ attempt.status }}</span> <span class="muted">{{ attempt.detail }}</span></li>
  {% endfor %}
</ul>
{% endif %}

</section>
<p class="muted mono type-caption">
  report {{ report.id }} ·
  <span title="{{ report.build.commit_sha }}">build {{ report.build.commit_short }}</span> ·
  rúbrica {{ report.analysis_contract.rubric_version or "unknown" }} ·
  prompt {{ report.analysis_contract.interpretation_prompt_version or "unknown" }} ·
  evaluador {{ report.analysis_contract.evaluator_model or "unknown" }}
</p>
{% endblock %}
