{% extends "base.html.j2" %}
{% block title %}Moodboard · {{ moodboard.brand_name }} — B3S{% endblock %}
{% block main_class %}wide{% endblock %}
{% block content %}
<p>
  <a href="/">← Todos los informes</a> ·
  <a href="/report/{{ moodboard.report_id }}">SV9 Score</a>
  {% if moodboard.brand_domain %} · <a href="/brand/{{ moodboard.brand_domain }}?lang=es">Ficha de marca</a>{% endif %}
</p>

<section class="moodboard-hero">
  <div class="moodboard-identity">
    <div class="moodboard-logo" aria-hidden="true">
      {% if moodboard.logo_image %}
      <img src="{{ moodboard.logo_image.url }}" alt="">
      {% else %}
      <span>{{ moodboard.brand_name[:1] }}</span>
      {% endif %}
    </div>
    <div class="moodboard-meta">
      <div class="section-head">
        <span class="label">moodboard visual</span>
        <span class="tag">// assets propios capturados</span>
      </div>
      <h1 class="moodboard-title">{{ moodboard.brand_name }}</h1>
      {% if moodboard.url %}
      <a class="report-hero-url moodboard-url" href="{{ moodboard.url }}" target="_blank" rel="noopener noreferrer">{{ moodboard.url }}</a>
      {% endif %}
    </div>
  </div>
  <div class="moodboard-asset-count">
    <div class="report-hero-label">assets</div>
    <div class="moodboard-count">{{ moodboard.image_count }}</div>
    {% if moodboard.score is not none %}
    <div class="report-hero-note">SV9 {{ moodboard.score }}/100</div>
    {% endif %}
  </div>
</section>

<section>
  <div class="section-head">
    <span class="label">Moodboard</span>
    <span class="tag">// arrastra para rotar · rueda para zoom</span>
    {% if moodboard.images %}
    <button class="source-link source-link-button moodboard-shuffle" type="button" data-moodboard-shuffle>reorganizar</button>
    {% endif %}
  </div>
  {% if moodboard.images %}
  <div class="moodboard-stage cloud-stage" data-moodboard-stage aria-label="Moodboard interactivo">
    <div class="cloud-layer" data-cloud-layer></div>
    <canvas class="moodboard-grain" data-moodboard-grain></canvas>
    <div class="moodboard-vignette"></div>
  </div>
  <script type="application/json" data-moodboard-items>{{ moodboard.images | tojson }}</script>
  <script src="/static/brand3_cloud.js" defer></script>
  <script src="/static/moodboard.js" defer></script>
  {% else %}
  <p class="muted">No hay assets visuales persistidos para este scan.</p>
  {% endif %}
  <p class="muted mono moodboard-help">
    Las imágenes enlazan a los assets originales capturados en la evidencia. Un hueco vacío significa que el asset ya no es accesible.
  </p>
</section>

{% if moodboard.visual_reading %}
<section>
  <div class="section-head">
    <span class="label">Lectura visual</span>
    <span class="tag">// bloques estratégicos que enmarcan las imágenes</span>
  </div>
  <div class="moodboard-reading">
    {% for block in moodboard.visual_reading %}
    <article class="panel">
      <h2 class="card-title">{{ block.key | replace('_', ' ') }}</h2>
      <p class="prose">{{ block.text }}</p>
    </article>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if moodboard.images %}
<section>
  <div class="section-head">
    <span class="label">Inventario de imágenes</span>
    <span class="tag">// assets capturados y su rol</span>
  </div>
  <div class="overflow panel" style="padding:0">
    <table>
      <thead><tr><th>url</th><th>rol</th><th>texto alt</th></tr></thead>
      <tbody>
      {% for image in moodboard.images %}
      <tr>
        <td class="mono muted"><a href="{{ image.url }}" target="_blank" rel="noopener noreferrer">{{ image.url }}</a></td>
        <td><span class="chip">{{ image.role }}</span></td>
        <td class="muted">{{ image.alt or "—" }}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endif %}
{% endblock %}
