{% extends "base.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block content %}
<div class="page-head">
  <h1>Scan a brand</h1>
</div>

{% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}

<form class="panel" method="post" action="/scan" data-b3s-scan-form>
  <div class="form-row">
    <label class="grow">
      <span class="muted">Brand URL</span>
      <input type="url" name="url" placeholder="https://vercel.com" required autofocus>
    </label>
    <label>
      <span class="muted">Brand name (optional)</span>
      <input type="text" name="brand_name" placeholder="Vercel">
    </label>
    <div class="form-action">
      <button type="submit">Run evidence scan</button>
    </div>
  </div>
  <div class="form-options">
    <label class="check-row">
      <input type="checkbox" name="allow_degraded_fallback" value="true">
      <span>allow degraded fallback if acquisition fails</span>
    </label>
  </div>
</form>

<div class="page-head page-head--section">
  <h2>Marcas</h2>
  <span class="muted mono">{{ reports | length if reports else 0 }} análisis</span>
</div>
{% if reports %}
<div class="overflow panel" style="padding:0">
<table class="reports-table">
  <thead>
    <tr><th>Brand</th><th>Score</th><th>Coverage</th><th>Not detected</th><th>Day</th></tr>
  </thead>
  <tbody>
  {% for row in reports %}
    <tr data-row-href="/brand/{{ row.brand_domain }}?lang=es" tabindex="0" aria-label="Abrir análisis de {{ row.brand_name or row.brand_domain }}">
      <td>
        <div class="brand-cell">
          {% if row.brand_domain %}
          <a href="/brand/{{ row.brand_domain }}?lang=es">{{ row.brand_name or row.id }}</a>
          {% else %}
          <a href="/report/{{ row.id }}">{{ row.brand_name or row.id }}</a>
          {% endif %}
          <span class="brand-cell-url">{{ row.url }}</span>
        </div>
      </td>
      <td class="mono">
        <strong>{{ row.score_publication.raw_value if row.score_publication.raw_value is not none else "—" }}</strong>
        {% if not row.score_publication.publishable %}<span class="muted"> diagnóstico</span>{% endif %}
      </td>
      <td class="mono">{{ row.detected_count }}/{{ row.block_count }}</td>
      <td>
        {% for name in row.not_detected %}{{ ui.tag(name, "warn") }} {% else %}{{ ui.tag("none", "ok") }}{% endfor %}
      </td>
      <td class="muted mono">{{ (row.created_at or "")[8:10] if row.created_at else "—" }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% else %}
<p class="muted">Aún no hay análisis — lanza el primer scan arriba.</p>
{% endif %}

<div hidden data-b3s-webmcp-surface="floc"></div>
<script src="/static/vault_webmcp_loader.js" defer></script>
{% endblock %}
