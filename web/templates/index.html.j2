{% extends "base.html.j2" %}
{% block content %}
<h1>Scan a brand</h1>

{% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}

<form class="panel" method="post" action="/scan">
  <div class="form-row">
    <label class="grow">
      <span class="muted">Brand URL</span>
      <input type="url" name="url" placeholder="https://vercel.com" required autofocus>
    </label>
    <label>
      <span class="muted">Brand name (optional)</span>
      <input type="text" name="brand_name" placeholder="Vercel">
    </label>
  </div>
  <p class="muted" style="font-size:13px">Live capture: owned pages, Exa mentions/news, GitHub repository proof, SearchAPI fallback. Scoring runs shadow-only.</p>
  <button type="submit">Run evidence scan</button>
</form>

<h2>Reports</h2>
{% if reports %}
<div class="overflow panel" style="padding:0">
<table>
  <thead>
    <tr><th>Brand</th><th>URL</th><th>Score</th><th>Blocks</th><th>Not detected</th><th>When</th></tr>
  </thead>
  <tbody>
  {% for row in reports %}
    <tr>
      <td><a href="/report/{{ row.id }}">{{ row.brand_name or row.id }}</a></td>
      <td class="mono muted">{{ row.url }}</td>
      <td class="mono">{{ row.score if row.score is not none else "—" }}</td>
      <td class="mono">{{ row.detected_count }}/{{ row.block_count }}</td>
      <td>
        {% for name in row.not_detected %}<span class="chip warn">{{ name }}</span> {% else %}<span class="chip ok">none</span>{% endfor %}
      </td>
      <td class="muted mono">{{ (row.created_at or "")[:16].replace("T", " ") }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% else %}
<p class="muted">No reports yet — run the first scan above.</p>
{% endif %}
{% endblock %}
