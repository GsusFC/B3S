{% extends "base.html.j2" %}
{% block title %}Scoring Lab — B3S{% endblock %}
{% block content %}
<p><a href="/">← Todos los informes</a></p>

<section class="panel">
  <div class="section-head">
    <span class="label">scoring_lab</span>
    <span class="tag">// SQLite · {{ lab.db_path }}</span>
  </div>
  <h1>Scoring Lab</h1>
  <p class="muted">
    Backfill de {{ imported }} reports JSON. Esta vista convierte scans en datos comparables para detectar gates duros, puntos ciegos repetidos y componentes infra/sobre puntuados.
  </p>
  <p>
    <a class="source-link" href="/api/scoring/lab">JSON</a>
  </p>
</section>

<div class="health-summary">
  <div class="health-card">
    <div class="k">runs</div>
    <div class="v">{{ lab.stats.run_count or 0 }}</div>
  </div>
  <div class="health-card">
    <div class="k">marcas</div>
    <div class="v">{{ lab.stats.brand_count or 0 }}</div>
  </div>
  <div class="health-card">
    <div class="k">score medio</div>
    <div class="v">{{ lab.stats.avg_score or "—" }}</div>
  </div>
  <div class="health-card">
    <div class="k">runs &lt; 70</div>
    <div class="v">{{ lab.stats.runs_below_70 or 0 }}</div>
  </div>
</div>

<h2>Runs Recientes</h2>
<section class="panel overflow" style="padding:0">
  <table>
    <thead>
      <tr>
        <th>Marca</th>
        <th>Dominio</th>
        <th>Score</th>
        <th>Blocks</th>
        <th>Reliability</th>
        <th>Fecha</th>
      </tr>
    </thead>
    <tbody>
      {% for run in lab.recent_runs %}
      <tr>
        <td><a href="/report/{{ run.id }}">{{ run.brand_name or run.id }}</a></td>
        <td class="mono muted">{{ run.domain }}</td>
        <td class="mono">{{ run.score if run.score is not none else "—" }}</td>
        <td class="mono">{{ run.detected_count or 0 }}/{{ run.block_count or 0 }}</td>
        <td><span class="chip">{{ run.reliability_status or "—" }}</span></td>
        <td class="mono muted">{{ (run.created_at or "")[:16].replace("T", " ") }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</section>

<h2>Componentes</h2>
<section class="panel overflow" style="padding:0">
  <table>
    <thead>
      <tr>
        <th>Componente</th>
        <th>Samples</th>
        <th>Score Medio</th>
        <th>No Detectado</th>
        <th>Refs Medio</th>
      </tr>
    </thead>
    <tbody>
      {% for row in lab.component_stats %}
      <tr>
        <td class="mono">{{ row.label }}</td>
        <td class="mono">{{ row.samples }}</td>
        <td class="mono">{{ row.avg_score if row.avg_score is not none else "—" }}</td>
        <td class="mono">{{ row.not_detected }}</td>
        <td class="mono">{{ row.avg_refs if row.avg_refs is not none else "—" }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</section>

<h2>Gaps De Scoring</h2>
<section class="panel overflow" style="padding:0">
  <table>
    <thead>
      <tr>
        <th>Run</th>
        <th>Score</th>
        <th>Componente</th>
        <th>Estado</th>
        <th>Nota</th>
        <th>Refs</th>
      </tr>
    </thead>
    <tbody>
      {% for row in lab.score_gaps %}
      <tr>
        <td><a href="/report/{{ row.run_id }}">{{ row.brand_name }}</a></td>
        <td class="mono">{{ row.run_score }}</td>
        <td class="mono">{{ row.label }}</td>
        <td><span class="chip {{ 'bad' if row.status != 'scored' else 'warn' }}">{{ row.status }}</span></td>
        <td class="mono">{{ row.score if row.score is not none else "—" }}/{{ row.max_score }}</td>
        <td class="mono">{{ row.ref_count }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</section>

<h2>Baldosas Repetidas</h2>
<section class="panel overflow" style="padding:0">
  <table>
    <thead>
      <tr>
        <th>Componente</th>
        <th>Baldosa</th>
        <th>Estado</th>
        <th>Veces</th>
      </tr>
    </thead>
    <tbody>
      {% for row in lab.tile_stats %}
      <tr>
        <td class="mono">{{ row.component_key }}</td>
        <td class="mono">{{ row.tile_id }}</td>
        <td><span class="chip {{ 'ok' if row.state == 'ok' else 'bad' if row.state == 'no' else 'warn' }}">{{ row.state }}</span></td>
        <td class="mono">{{ row.count }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</section>

<h2>Evidencia</h2>
<section class="panel overflow" style="padding:0">
  <table>
    <thead>
      <tr>
        <th>Fuente</th>
        <th>Usos</th>
        <th>URLs únicas</th>
      </tr>
    </thead>
    <tbody>
      {% for row in lab.evidence_stats %}
      <tr>
        <td class="mono">{{ row.source_type }}</td>
        <td class="mono">{{ row.count }}</td>
        <td class="mono">{{ row.unique_urls }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</section>

<h2>Dominios Con Varios Runs</h2>
<section class="panel overflow" style="padding:0">
  <table>
    <thead>
      <tr>
        <th>Dominio</th>
        <th>Runs</th>
        <th>Min</th>
        <th>Max</th>
        <th>Media</th>
      </tr>
    </thead>
    <tbody>
      {% for row in lab.repeat_domains %}
      <tr>
        <td class="mono">{{ row.domain }}</td>
        <td class="mono">{{ row.runs }}</td>
        <td class="mono">{{ row.min_score }}</td>
        <td class="mono">{{ row.max_score }}</td>
        <td class="mono">{{ row.avg_score }}</td>
      </tr>
      {% else %}
      <tr><td colspan="5" class="muted">Sin dominios repetidos todavía.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</section>
{% endblock %}
