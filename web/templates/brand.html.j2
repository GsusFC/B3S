{% extends "base.html.j2" %}
{% block title %}{{ brand.display_name }} — B3S{% endblock %}
{% block content %}
<p><a href="/">← Todos los informes</a></p>

<section class="brand-profile-hero">
  <div class="brand-profile-identity">
    <div class="brand-profile-logo">
      {% if brand.domain %}
      <img class="brand-profile-favicon" src="https://icons.duckduckgo.com/ip3/{{ brand.domain }}.ico" alt="Logo de {{ brand.display_name }}" loading="lazy" style="width:100%;height:100%;object-fit:contain;border-radius:inherit" onerror="this.style.display='none';this.nextElementSibling.style.display=''">
      {% endif %}
      <span{% if brand.domain %} style="display:none"{% endif %}>{{ brand.display_name[:1] }}</span>
    </div>
    <div class="brand-profile-headline">
      <h1 class="brand-profile-title">{{ brand.display_name }}</h1>
      <a class="brand-profile-domain-link" href="{{ brand.url }}" rel="nofollow noopener">{{ brand.domain }}</a>
    </div>
  </div>

  <div class="brand-profile-terminal">
    <span class="brand-profile-terminal-key">sv9</span>
    {% if brand.current %}
    <strong class="brand-profile-score">{{ brand.current.score_publication.raw_value if brand.current.score_publication.raw_value is not none else "—" }}</strong>
    <span class="brand-profile-terminal-value">
      {{ brand.current.canonical_status or "sin_clasificar" }}
      · {{ brand.current.reliability_status or "unknown" }}
      {% if not brand.current.score_publication.publishable %} · diagnóstico{% endif %}
      / {{ (brand.current.created_at or "")[:10] }}
    </span>
    <a class="source-link" href="/report/{{ brand.current.id }}">ver SV9</a>
    {% if brand.latest_attempt and brand.latest_attempt.id != brand.current.id %}
    <a class="source-link" href="/report/{{ brand.latest_attempt.id }}">último intento</a>
    {% endif %}
    {% if brand.visual_module.available %}
    <a class="source-link" href="#modulo-visual">ver visual</a>
    {% endif %}
    {% if brand.vault_memory.enabled %}
    <a class="source-link" href="#memoria-vault">memoria vault</a>
    {% if brand.vault_memory.available and brand.vault_memory.review_queue.summary.total_count %}
    <a class="source-link" href="#cola-revision-vault">cola de revisión</a>
    {% endif %}
    {% endif %}
    {% else %}
    <strong class="brand-profile-score">—</strong>
    <span class="brand-profile-terminal-value is-empty">sin scan local</span>
    <form method="post" action="/scan" class="brand-profile-scan-form">
      <input type="hidden" name="url" value="{{ brand.url }}">
      <input type="hidden" name="brand_name" value="{{ brand.display_name }}">
      <button type="submit">escanear</button>
    </form>
    {% endif %}
  </div>
</section>

<section class="brand-profile-summary">
  {% if brand.vault_memory.enabled %}
  <section class="brand-profile-block vault-memory" id="memoria-vault">
    <div class="section-head">
      <span class="label">memoria_de_baldosas</span>
      <span class="tag">// vault aislado · solo sombra · sin efecto operativo</span>
    </div>
    {% if brand.vault_memory.available %}
    <p class="prose text-pretty">
      Compara únicamente scans con el mismo contrato de evaluación. Las versiones se conservan en PostgreSQL;
      ningún cambio modifica el informe ni el score vigente sin una decisión revisada.
    </p>

    <div class="vault-memory-metrics" aria-label="Resumen de memoria de baldosas">
      <article class="vault-memory-metric">
        <span>scans en memoria</span>
        <strong>{{ brand.vault_memory.report_count }}</strong>
      </article>
      <article class="vault-memory-metric">
        <span>baldosas actuales</span>
        <strong>{{ brand.vault_memory.summary.tile_count }}</strong>
      </article>
      <article class="vault-memory-metric">
        <span>cambios materiales</span>
        <strong>{{ brand.vault_memory.summary.changed_tile_count }}</strong>
      </article>
      <article class="vault-memory-metric">
        <span>pueden mover puntos</span>
        <strong>{{ brand.vault_memory.summary.score_affecting_change_count }}</strong>
      </article>
      <article class="vault-memory-metric">
        <span>calidad de evidencia</span>
        <strong>{{ brand.vault_memory.summary.evidence_quality_change_count }}</strong>
      </article>
      <article class="vault-memory-metric">
        <span>pendientes de revisión</span>
        <strong>{{ brand.vault_memory.summary.pending_review_count }}</strong>
      </article>
    </div>

    <section id="cola-revision-vault">
      <div class="section-head vault-memory-change-head">
        <span class="label">cola_de_revision_vault</span>
        <span class="tag">// score y calidad de evidencia · solo lectura</span>
      </div>
      <p class="prose text-pretty">
        Clasifica todos los cambios materiales por su canal seguro y distingue cuáles pueden mover puntos.
        Esta vista no muestra pasajes privados ni permite escribir decisiones; la firma sigue requiriendo
        la credencial de revisor y el journal protegido.
      </p>
      {% if brand.vault_memory.review_queue.summary.protected_candidate_count %}
      <p>
        <a class="source-link" href="/vault/review/{{ brand.domain }}">
          abrir revisión protegida · {{ brand.vault_memory.review_queue.summary.pending_protected_candidate_count }} pendientes
        </a>
      </p>
      {% endif %}
      <div class="vault-memory-metrics" aria-label="Estado de la cola de revisión del Vault">
        <article class="vault-memory-metric">
          <span>cambios materiales</span>
          <strong>{{ brand.vault_memory.review_queue.summary.total_count }}</strong>
        </article>
        <article class="vault-memory-metric">
          <span>pueden mover puntos</span>
          <strong>{{ brand.vault_memory.review_queue.summary.score_affecting_count }}</strong>
        </article>
        <article class="vault-memory-metric">
          <span>calidad de evidencia</span>
          <strong>{{ brand.vault_memory.review_queue.summary.evidence_quality_count }}</strong>
        </article>
        <article class="vault-memory-metric">
          <span>candidatos protegidos pendientes</span>
          <strong>{{ brand.vault_memory.review_queue.summary.pending_protected_candidate_count }}</strong>
        </article>
        <article class="vault-memory-metric">
          <span>requieren preparación</span>
          <strong>{{ brand.vault_memory.review_queue.summary.preparation_count }}</strong>
        </article>
        <article class="vault-memory-metric">
          <span>bloqueados correctamente</span>
          <strong>{{ brand.vault_memory.review_queue.summary.blocked_count }}</strong>
        </article>
        <article class="vault-memory-metric">
          <span>decisiones registradas</span>
          <strong>{{ brand.vault_memory.review_queue.summary.resolved_count }}</strong>
        </article>
      </div>
      {% if brand.vault_memory.review_queue["items"] %}
      <div class="overflow panel vault-memory-table-wrap">
        <table class="vault-memory-table">
          <thead><tr><th>baldosa</th><th>cambio</th><th>prioridad</th><th>canal</th><th>estado</th><th>siguiente acción</th></tr></thead>
          <tbody>
          {% for item in brand.vault_memory.review_queue["items"] %}
          <tr>
            <td class="mono"><strong>{{ item.tile_key }}</strong></td>
            <td>
              <span class="chip {{ item.impact_tone }}">{{ item.impact_label }}</span>
              <span class="mono muted">{{ item.state_change }}</span>
            </td>
            <td class="mono">{{ "puntos" if item.review_priority == "score_affecting" else "evidencia" }}</td>
            <td class="mono muted">{{ item.channel_label }}</td>
            <td><span class="chip {{ item.queue_tone }}">{{ item.queue_label }}</span></td>
            <td class="text-pretty">{{ item.next_action }}</td>
          </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
      <div class="panel vault-memory-empty">
        {% if brand.vault_memory.review_queue.summary.pending_protected_candidate_count %}
        <p class="text-pretty">No hay cambios materiales nuevos, pero quedan candidatos históricos pendientes.</p>
        <a href="/vault/review/{{ brand.domain }}">Abrir revisión protegida</a>
        {% else %}
        <p class="text-pretty">No hay cambios materiales comparables pendientes.</p>
        <a href="/">Ejecutar otro scan comparable</a>
        {% endif %}
      </div>
      {% endif %}
    </section>

    <div class="brand-profile-grid vault-memory-details">
      <section class="panel">
        <div class="section-head">
          <span class="label">trayectoria</span>
          <span class="tag">// scanner observado</span>
        </div>
        <dl class="brand-profile-kv">
          <dt>score anterior</dt><dd>{{ brand.vault_memory.trajectory.previous_score if brand.vault_memory.trajectory.previous_score is not none else "—" }}</dd>
          <dt>score último</dt><dd>{{ brand.vault_memory.trajectory.latest_score if brand.vault_memory.trajectory.latest_score is not none else "—" }}</dd>
          <dt>delta observado</dt><dd>{{ brand.vault_memory.trajectory.score_delta_latest_minus_previous if brand.vault_memory.trajectory.score_delta_latest_minus_previous is not none else "—" }}</dd>
          <dt>delta candidato</dt><dd>{{ brand.vault_memory.candidate_scoring.score_delta if brand.vault_memory.candidate_scoring.score_delta is not none else "—" }}</dd>
          <dt>delta revisado</dt><dd>{{ brand.vault_memory.reviewed_scoring.score_delta if brand.vault_memory.reviewed_scoring.score_delta is not none else "—" }}</dd>
        </dl>
      </section>
      <section class="panel">
        <div class="section-head">
          <span class="label">claim_a_baldosa</span>
          <span class="tag">// ledger persistente</span>
        </div>
        <dl class="brand-profile-kv">
          <dt>persistido</dt><dd>{{ "sí" if brand.vault_memory.ledger.stored else "no" }}</dd>
          <dt>mappings</dt><dd>{{ brand.vault_memory.ledger.mapping_count }}</dd>
          <dt>mappings actuales</dt><dd>{{ brand.vault_memory.ledger.current_mapping_count }}</dd>
          <dt>claims</dt><dd>{{ brand.vault_memory.ledger.claim_variant_count }}</dd>
          <dt>aceptados</dt><dd>{{ brand.vault_memory.ledger.accepted_mapping_count }}</dd>
          <dt>pendientes</dt><dd>{{ brand.vault_memory.ledger.pending_mapping_count }}</dd>
        </dl>
      </section>
    </div>

    <p class="vault-memory-contract mono muted">
      runtime_effect=false · authority=false · versión {{ brand.vault_memory.tile_memory_version[:12] or "sin-versión" }}
    </p>
    {% else %}
    <div class="panel vault-memory-empty">
      <p class="text-pretty">{{ brand.vault_memory.message or "No hay informes persistidos para construir esta memoria." }}</p>
      <a href="/">Ejecutar el primer scan</a>
    </div>
    {% endif %}
  </section>
  {% endif %}

  {% if brand.visual_module.available %}
  <section class="brand-profile-block brand-profile-visual" id="modulo-visual">
    <div class="section-head">
      <span class="label">módulo_visual</span>
      <span class="tag">// {{ brand.visual_module.image_count }} assets de marca seleccionados</span>
    </div>
    {% if brand.visual_module.images %}
    <div class="moodboard-stage moodboard-stage--brand cloud-stage" data-moodboard-stage aria-label="Moodboard visual de {{ brand.display_name }}">
      <div class="cloud-layer" data-cloud-layer></div>
      <canvas class="moodboard-grain" data-moodboard-grain></canvas>
      <div class="moodboard-vignette"></div>
    </div>
    <script type="application/json" data-moodboard-items>{{ brand.visual_module.images | tojson }}</script>
    <script src="/static/brand3_cloud.js" defer></script>
    <script src="/static/moodboard.js" defer></script>
    <p class="page-tools brand-visual-actions">
      <button class="source-link source-link-button moodboard-shuffle" type="button" data-moodboard-shuffle>reorganizar</button>
    </p>
    {% else %}
    <p class="muted">No hay assets visuales persistidos para este scan.</p>
    {% endif %}

    {% if brand.visual_module.visual_reading %}
    <div class="section-head">
      <span class="label">lectura_visual</span>
      <span class="tag">// bloques estratégicos que enmarcan las imágenes</span>
    </div>
    <div class="moodboard-reading">
      {% for block in brand.visual_module.visual_reading %}
      <article class="panel">
        <h3 class="card-title">{{ block.key | replace('_', ' ') }}</h3>
        <p class="prose">{{ block.text }}</p>
      </article>
      {% endfor %}
    </div>
    {% endif %}

    {% if brand.visual_module.images %}
    <div class="section-head">
      <span class="label">inventario</span>
      <span class="tag">// selección {{ brand.visual_module.selection_version }}</span>
    </div>
    <div class="overflow panel" style="padding:0">
      <table>
        <thead><tr><th>url</th><th>rol</th><th>origen</th><th>selección</th><th>texto alt</th></tr></thead>
        <tbody>
        {% for image in brand.visual_module.images %}
        <tr>
          <td class="mono muted"><a href="{{ image.url }}" target="_blank" rel="noopener noreferrer">{{ image.url }}</a></td>
          <td><span class="chip">{{ image.role }}</span></td>
          <td class="muted">{{ image.source or "—" }}</td>
          <td class="muted">{{ image.selection_reason or "—" }}</td>
          <td class="muted">{{ image.alt or "—" }}</td>
        </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
  </section>
  {% endif %}

  <div class="brand-profile-grid">
    <section class="brand-profile-block">
      <div class="section-head">
        <span class="label">qué_hace</span>
        <span class="tag">// desde evidencia B3S</span>
      </div>
      {% if brand.summary or brand.outcome %}
      {% if brand.summary %}<p class="prose">{{ brand.summary }}</p>{% endif %}
      {% if brand.outcome %}<p class="muted">{{ brand.outcome }}</p>{% endif %}
      {% else %}
      <p class="muted">No hay scan local para este dominio.</p>
      {% endif %}
    </section>

    <section class="brand-profile-block">
      <div class="section-head">
        <span class="label">estado</span>
        <span class="tag">// cobertura SV9</span>
      </div>
      <dl class="brand-profile-kv">
        <dt>componentes</dt><dd>{{ brand.detected_count }}/{{ brand.component_count }}</dd>
        <dt>faltan</dt><dd>{% if brand.not_detected %}{{ brand.not_detected | join(", ") }}{% else %}none{% endif %}</dd>
        {% if brand.current %}
        <dt>referencia</dt><dd>{{ brand.current.canonical_status or "sin_clasificar" }}</dd>
        <dt>comparador</dt><dd>{{ (brand.current.stability or {}).classification or "sin_datos" }}</dd>
        <dt>margen</dt><dd>+{{ brand.current.immediate_margin or 0 }} pts</dd>
        <dt>hueco</dt><dd>{{ brand.current.most_painful_gap_label or "—" }}</dd>
        {% endif %}
      </dl>
    </section>
  </div>

  <div class="brand-profile-grid">
    <section class="brand-profile-block">
      <div class="section-head">
        <span class="label">links_detectados</span>
        <span class="tag">// evidencia fuente</span>
      </div>
      {% if brand.proof_urls %}
      <ul class="brand-profile-evidence-list">
        {% for url in brand.proof_urls %}
        <li><a href="{{ url }}" rel="nofollow noopener">{{ url }}</a></li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="muted">Sin fuentes capturadas todavía.</p>
      {% endif %}
    </section>

    <section class="brand-profile-block">
      <div class="section-head">
        <span class="label">historial_de_scans</span>
        <span class="tag">// {{ brand.reports | length }} ejecuciones</span>
      </div>
      {% if brand.reports %}
      <table>
        <thead><tr><th>fecha</th><th>score</th><th>estado</th><th>comparación</th><th>run</th><th></th></tr></thead>
        <tbody>
        {% for row in brand.reports %}
        <tr>
          <td class="muted mono">{{ (row.created_at or "")[:10] }}</td>
          <td class="mono">
            {{ row.score_publication.raw_value if row.score_publication.raw_value is not none else "—" }}
            {% if not row.score_publication.publishable %}<span class="muted"> diagnóstico</span>{% endif %}
          </td>
          <td class="muted mono">{{ row.canonical_status or "sin_clasificar" }}</td>
          <td class="muted mono">{{ (row.stability or {}).classification or "sin_datos" }}</td>
          <td class="muted mono">{{ row.id }}</td>
          <td>
            {% if brand.current and row.id == brand.current.id %}<span class="chip ok">SV9</span>{% endif %}
            {% if brand.latest_attempt and row.id == brand.latest_attempt.id and (not brand.current or row.id != brand.current.id) %}<span class="chip warn">último intento</span>{% endif %}
            <a href="/report/{{ row.id }}">ver</a>
          </td>
        </tr>
        {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p class="muted">Cuando exista un scan de {{ brand.domain }}, aparecerá aquí.</p>
      {% endif %}
    </section>
  </div>
</section>
{% endblock %}
