{% extends "base.html.j2" %}
{% import "_components.html.j2" as ui %}
{% block title %}Scanning {{ scan.brand_name }} — B3S{% endblock %}
{% block main_class %}scan-main{% endblock %}
{% set scan_preview = scan.preview if scan.preview is defined else false %}
{% set phase_labels = {
  "capture": "Captura de evidencia",
  "interpret": "Interpretación SV9",
  "score": "Scoring",
  "report": "Reporte",
} %}
{% set progress = namespace(done=0, active_label="Preparando scanner", active_state=scan.state or "running") %}
{% for phase in scan.phases %}
  {% if phase.state == "done" %}
    {% set progress.done = progress.done + 1 %}
  {% endif %}
  {% if phase.state in ["running", "blocked", "error"] %}
    {% set progress.active_label = phase_labels.get(phase.key, phase.label) %}
    {% set progress.active_state = phase.state %}
  {% endif %}
{% endfor %}
{% set meter_segments = 72 %}
{% set meter_active = ((progress.done * meter_segments) / (scan.phases|length if scan.phases else 1))|round(0, "ceil")|int %}
{% block content %}
{% set result = namespace(unresolved=false, failed=false) %}
{% for phase in scan.phases %}
  {% if phase.state in ["blocked", "error"] %}{% set result.unresolved = true %}{% endif %}
  {% if phase.state == "error" %}{% set result.failed = true %}{% endif %}
{% endfor %}
<div class="scan-shell">
  <section class="scan-card" aria-live="polite">
    <div class="scan-identity">
      <div class="scan-brandmark" aria-hidden="true">B3S</div>
      <p class="scan-kicker">SV9 scanner</p>
      <h1 class="scan-title">{{ scan.brand_name }}</h1>
      <a class="scan-url" href="{{ scan.url }}" target="_blank" rel="noopener noreferrer">{{ scan.url }}</a>
    </div>

    <div class="scan-meter" id="scan-meter" aria-label="Progreso del scanner">
      {% for index in range(meter_segments) %}
      <span class="scan-meter-bar {{ 'is-on' if index < meter_active else '' }}"></span>
      {% endfor %}
    </div>

    <ol class="plain scan-steps" id="phases">
      {% for phase in scan.phases %}
      <li class="scan-step is-{{ phase.state }}" data-key="{{ phase.key }}">
        <span class="scan-step-mark" aria-hidden="true"></span>
        <span class="scan-step-copy">
          <span class="scan-step-label">{{ phase_labels.get(phase.key, phase.label) }}</span>
        </span>
        <span class="scan-step-state" data-state-label>{{ phase.state }}</span>
      </li>
      {% endfor %}
    </ol>

    <section class="scan-gate" id="gate" hidden>
      <div>
        <h2 id="gate-title">Adquisición incompleta</h2>
      </div>
      <div class="scan-gate-issues" id="gate-issues"></div>
      <div class="scan-gate-actions" id="gate-actions" hidden>
        <button type="button" id="gate-continue">Continuar degradado</button>
        <button type="button" class="danger" id="gate-cancel">Cancelar</button>
      </div>
    </section>

    <section class="scan-gate" id="scan-result" role="status" {% if scan.state != "done" or not result.unresolved %}hidden{% endif %}>
      <h2 id="result-message">{{ "No se pudo completar una evaluación SV9 válida." if result.failed else "La evaluación SV9 requiere revisión." }}</h2>
      <p id="result-score-message">{{ "Se conserva el score y el informe previamente aceptados." if scan.score_unchanged else "No se generó un score nuevo." }}</p>
      <a id="result-report" href="/report/{{ scan.report_id or scan.id }}">Ver informe disponible</a>
    </section>
    <p class="scan-hint" id="hint" hidden></p>
    <p class="error" id="error" role="alert" hidden></p>
  </section>

  <details class="scan-technical">
    <summary>
      <span>Detalle técnico</span>
      <span class="muted">fuentes, estados y trazabilidad</span>
    </summary>
    <div class="scan-acquisition-table">
      <table>
        <thead><tr><th>Source</th><th>Status</th><th>Detail</th></tr></thead>
        <tbody id="acquisition">
          {% if scan.acquisition %}
          {% for row in scan.acquisition %}
          <tr>
            <td class="mono">{{ row.source }}</td>
            <td>{{ ui.acquisition_status_tag(row.source, row.status, row.evidence_status|default(""), row.first_fold_evaluable|default(none)) }}</td>
            <td class="muted">{{ row.detail }}</td>
          </tr>
          {% endfor %}
          {% else %}
          <tr><td colspan="3" class="muted">Waiting for capture...</td></tr>
          {% endif %}
        </tbody>
      </table>
    </div>
  </details>
</div>

<script>
const scanId = {{ scan.id | tojson }};
const scanPreview = {{ scan_preview | tojson }};
const initialPhases = {{ scan.phases | tojson }};
const initialGate = {{ (scan.acquisition_gate if scan.acquisition_gate is defined else none) | tojson }};
const initialState = {{ (scan.state or "running") | tojson }};
const meterSegments = 72;
const phaseDurations = {
  capture: 9000,
  interpret: 24000,
  score: 8000,
  report: 6000,
};
let lastPhases = initialPhases;
let activePhaseSignature = "";
let activePhaseStartedAt = performance.now();
const stateLabel = {
  done: "completado",
  running: "en curso",
  pending: "pendiente",
  error: "error",
  blocked: "bloqueado",
  cancelled: "cancelado",
};
const okStatuses = new Set(["ok", "fetched", "configured", "captured", "usable", "completed", "scored", "done", "pass"]);
const badStatuses = new Set(["error", "missing", "blocked", "cancelled", "failed"]);
const warnStatuses = new Set(["warn", "warning", "empty", "limited", "skipped", "pending", "running", "missing_key", "disabled", "degraded_approved"]);

function esc(value) {
  const div = document.createElement("div");
  div.textContent = value == null ? "" : String(value);
  return div.innerHTML;
}

function visualAcquisitionIsLimited(source, status, evidenceStatus, firstFoldEvaluable) {
  const normalizedSource = String(source || "");
  const normalizedStatus = String(status || "").toLowerCase();
  const normalizedEvidenceStatus = String(evidenceStatus || "").toLowerCase();
  if (normalizedSource !== "visual_acquisition") return false;
  if (["error", "failed", "timeout", "acquisition_failed"].includes(normalizedStatus)) return true;
  if (["blocked", "limited", "missing", "not_interpretable", "unavailable"].includes(normalizedEvidenceStatus)) return true;
  return firstFoldEvaluable === false;
}

function displayStatusValue(value, source, evidenceStatus, firstFoldEvaluable) {
  if (visualAcquisitionIsLimited(source, value, evidenceStatus, firstFoldEvaluable)) return "limited";
  if (String(source || "") === "visual_acquisition" && evidenceStatus) return evidenceStatus;
  return value;
}

function statusTone(value, source, evidenceStatus, firstFoldEvaluable) {
  if (visualAcquisitionIsLimited(source, value, evidenceStatus, firstFoldEvaluable)) return "warn";
  const normalized = String(
    String(source || "") === "visual_acquisition" && evidenceStatus ? evidenceStatus : value
  ).toLowerCase();
  if (okStatuses.has(normalized)) return "ok";
  if (badStatuses.has(normalized)) return "bad";
  if (warnStatuses.has(normalized)) return "warn";
  return "neutral";
}

function statusTag(value, source = "", evidenceStatus = "", firstFoldEvaluable = null) {
  const displayValue = displayStatusValue(value, source, evidenceStatus, firstFoldEvaluable);
  const tone = statusTone(value, source, evidenceStatus, firstFoldEvaluable);
  return `<span class="status-tag status-tag--${tone} status-tag--filled">${esc(displayValue)}</span>`;
}

async function poll() {
  let payload;
  try {
    const response = await fetch(`/api/scan/${scanId}`);
    payload = await response.json();
  } catch {
    setTimeout(poll, 3000);
    return;
  }
  renderProgress(payload.phases || []);
  const acquisition = payload.acquisition || [];
  if (acquisition.length) {
    document.getElementById("acquisition").innerHTML = acquisition
      .map(row => `<tr><td class="mono">${esc(row.source)}</td>` +
        `<td>${statusTag(row.status, row.source, row.evidence_status, row.first_fold_evaluable)}</td>` +
        `<td class="muted">${esc(row.detail)}</td></tr>`)
      .join("");
  }
  renderGate(payload.acquisition_gate || null, payload.state);
  if (payload.state === "done") {
    if (renderCompletedResult(payload)) return;
    const reportId = payload.report_id || scanId;
    window.location.href = `/report/${reportId}`;
    return;
  }
  if (payload.state === "blocked" || payload.state === "cancelled") {
    if (payload.state === "cancelled") {
      const hint = document.getElementById("hint");
      hint.textContent = "Scan cancelado antes del scoring.";
      hint.hidden = false;
    }
    return;
  }
  if (payload.state === "error") {
    const box = document.getElementById("error");
    box.textContent = payload.diagnostic?.summary || "Scan failed before completion.";
    box.hidden = false;
    document.getElementById("hint").hidden = true;
    return;
  }
  setTimeout(poll, 1500);
}

function renderCompletedResult(payload) {
  const phases = payload.phases || [];
  const unresolved = payload.state === "done" && phases.some(phase => ["blocked", "error"].includes(phase.state));
  const panel = document.getElementById("scan-result");
  panel.hidden = !unresolved;
  if (!unresolved) return false;
  document.getElementById("result-message").textContent = phases.some(phase => phase.state === "error")
    ? "No se pudo completar una evaluación SV9 válida."
    : "La evaluación SV9 requiere revisión.";
  document.getElementById("result-score-message").textContent = payload.score_unchanged
    ? "Se conserva el score y el informe previamente aceptados."
    : "No se generó un score nuevo.";
  document.getElementById("result-report").href = `/report/${payload.report_id || scanId}`;
  document.getElementById("gate-actions").hidden = true;
  return true;
}

function renderGate(gate, scanState) {
  const panel = document.getElementById("gate");
  const card = document.querySelector(".scan-card");
  if (!gate || !gate.state || gate.state === "pending" || gate.state === "pass") {
    panel.hidden = true;
    if (card) card.classList.remove("scan-card--decision");
    return;
  }
  panel.hidden = false;
  if (card) card.classList.add("scan-card--decision");
  const blocked = gate.state === "blocked" && scanState === "blocked";
  const canContinue = Boolean(gate.can_continue);
  const issues = [...(gate.issues || []), ...(gate.warnings || [])];
  document.getElementById("gate-title").textContent = blocked
    ? "Adquisición bloqueada"
    : "Evidencia limitada";
  document.getElementById("gate-issues").innerHTML = issues.map(item =>
    `<div class="scan-gate-issue">` +
    `<div class="scan-gate-issue-head"><span>${esc(item.source)}</span><span class="muted">${esc(compactGateMessage(item))}</span></div>` +
    `</div>`
  ).join("");
  const continueButton = document.getElementById("gate-continue");
  const actionRow = document.getElementById("gate-actions");
  actionRow.hidden = !blocked;
  continueButton.disabled = !blocked || !canContinue || scanState === "cancelled";
  continueButton.hidden = !canContinue;
  document.getElementById("gate-cancel").disabled = scanState === "cancelled";
}

function compactGateMessage(item) {
  if (item.source === "visual_acquisition") {
    if (item.first_fold_evaluable === false || item.evidence_status === "blocked") {
      return "La primera pantalla visual está obstruida o no es evaluable.";
    }
    return "La captación visual no produjo evidencia utilizable.";
  }
  if (item.source === "web") {
    return "La captura web no produjo evidencia suficiente.";
  }
  if (item.source === "exa") {
    return "La prueba externa no devolvió resultados útiles.";
  }
  return item.message || item.code || item.status || "Limitación registrada.";
}

function renderProgress(phases) {
  const safePhases = phases || [];
  lastPhases = safePhases;
  let done = 0;
  let current = safePhases.find(phase => ["running", "blocked", "error"].includes(phase.state));
  const signature = current ? `${current.key}:${current.state}` : "";
  if (signature && signature !== activePhaseSignature) {
    activePhaseSignature = signature;
    activePhaseStartedAt = performance.now();
  }
  for (const phase of safePhases) {
    if (phase.state === "done") done += 1;
    const row = document.querySelector(`#phases li[data-key="${phase.key}"]`);
    if (!row) continue;
    row.className = `scan-step is-${phase.state}`;
    const labelNode = row.querySelector("[data-state-label]");
    if (labelNode) labelNode.textContent = stateLabel[phase.state] || phase.state;
  }
  if (!current && safePhases.length) {
    current = safePhases[Math.min(done, safePhases.length - 1)];
  }
  paintMeter(safePhases);
}

function phaseRatio(phase) {
  if (phase.state === "done") return 1;
  if (phase.state === "blocked" || phase.state === "error") return 0.35;
  if (phase.state !== "running") return 0;
  const duration = phaseDurations[phase.key] || 12000;
  return Math.min(0.94, (performance.now() - activePhaseStartedAt) / duration);
}

function rgbGradient(ratio) {
  const red = Math.round(46 + (209 * ratio));
  return `rgb(${red} 0 0)`;
}

function paintMeter(phases) {
  const safePhases = phases || [];
  const bars = document.querySelectorAll("#scan-meter .scan-meter-bar");
  if (!safePhases.length || !bars.length) return;
  const phaseSize = meterSegments / safePhases.length;
  let filled = 0;
  for (const phase of safePhases) {
    filled += phaseRatio(phase) * phaseSize;
  }
  bars.forEach((bar, index) => {
    const isActive = index < filled;
    const ratio = meterSegments > 1 ? index / (meterSegments - 1) : 0;
    bar.classList.toggle("is-on", isActive);
    bar.style.setProperty("--scan-bar-color", rgbGradient(ratio));
  });
}

function animateMeter() {
  paintMeter(lastPhases);
  window.requestAnimationFrame(animateMeter);
}

async function postAction(path) {
  const response = await fetch(path, { method: "POST" });
  const payload = await response.json();
  if (!response.ok) {
    const box = document.getElementById("error");
    box.textContent = payload.reason || "Action could not be applied.";
    box.hidden = false;
  }
  setTimeout(poll, 250);
}

document.getElementById("gate-continue").addEventListener("click", () => {
  if (scanPreview) return;
  postAction(`/api/scan/${scanId}/continue`);
});
document.getElementById("gate-cancel").addEventListener("click", () => {
  if (scanPreview) return;
  postAction(`/api/scan/${scanId}/cancel`);
});
renderProgress(initialPhases);
window.requestAnimationFrame(animateMeter);
if (scanPreview) {
  renderGate(initialGate, initialState);
} else {
  poll();
}
</script>
{% endblock %}
