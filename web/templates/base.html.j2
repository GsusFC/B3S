    .brand-profile-hero,
    .brand-profile-grid { grid-template-columns: 1fr; }
    .brand-profile-terminal { border-left: 0; border-top: 1px solid var(--line); padding: 14px 0 0; }
    .report-hero { grid-template-columns: 1fr 1fr; }
    .report-hero-main { grid-column: 1 / -1; border-right: 0; border-bottom: 1px solid var(--line); }
    .canvas { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .component-card--third, .component-card--half { grid-column: span 1; }
    .component-card--full { grid-column: 1 / -1; }
  }
  @media (max-width: 680px) {
    .form-row { grid-template-columns: 1fr; }
    .form-action button { width: 100%; }
    .vault-review-grid { grid-template-columns: 1fr; }
    .page-head { align-items: start; flex-direction: column; }
    .page-tools { justify-content: flex-start; }
    .report-hero { grid-template-columns: 1fr; }
    .report-hero-main,
    .report-hero-metric:not(:last-child) { border-right: 0; border-bottom: 1px solid var(--line); }
    .scan-shell { margin-top: 8px; }
    .scan-card { padding: 18px; }
    .scan-meter {
      gap: 1px;
    }
    .scan-meter-bar {
      width: 2px;
      height: 16px;
    }
    .scan-step {
      grid-template-columns: 6px minmax(0, 1fr) auto;
      min-height: 42px;
      gap: var(--space-sm);
      padding: 0 var(--space-sm);
    }
    .scan-step-mark {
      width: 3px;
      height: 22px;
    }
    .scan-technical summary {
      display: grid;
      gap: 4px;
    }
    .moodboard-hero { grid-template-columns: 1fr; }
    .moodboard-identity { align-items: flex-start; padding: 14px; }
    .moodboard-logo {
      flex-basis: 54px;
      width: 54px;
      height: 54px;
      font-size: var(--type-logo-sm);
    }
    .moodboard-asset-count {
      border-left: 0;
      border-top: 1px solid var(--line);
      padding: 14px;
    }
    .canvas { grid-template-columns: 1fr; }
    .component-card--third, .component-card--half, .component-card--full { grid-column: 1 / -1; min-height: 0; }
    .acquisition-metric { min-height: 0; }
    .drawer-tile { grid-template-columns: 50px minmax(0, 1fr); padding: 10px; }
    .drawer-tile-id { min-height: 54px; }
    .report-drawer-head h3 { font-size: var(--type-headline); }
  }
  @media (prefers-reduced-motion: reduce) {
    .report-score-bar span { animation: none; }
  }
</style>
</head>
