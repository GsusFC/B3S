<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}B3S — Brand Evidence Lab{% endblock %}</title>
<script>
  (() => {
    try {
      const storedTheme = window.localStorage.getItem("b3s-theme");
      if (storedTheme === "light" || storedTheme === "dark") {
        document.documentElement.dataset.theme = storedTheme;
      }
    } catch {
      // localStorage can be unavailable in strict/private contexts.
    }
  })();
</script>
<style>
  @import url("https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap");

  :root {
    color-scheme: light;
    --bg: #eeeeee; --panel: #f5f5f5; --panel-soft: rgba(245, 245, 245, 0.72);
    --ink: #161616; --muted: #77736d; --soft: #9a958e;
    --line: #e4e4e4; --line-strong: #d7d7d7;
    --accent: #ff0000; --ok: #00ff00; --warn: #0000ff; --bad: #b84f3f;
    --body-bg: repeating-linear-gradient(135deg, rgba(22, 22, 22, 0.018) 0 1px, transparent 1px 7px), var(--bg);
    --shadow: rgb(0 0 0 / 18%);
    --ui: "JetBrains Mono", ui-monospace, monospace;
    --mono: "JetBrains Mono", ui-monospace, monospace;
    --type-micro: 0.625rem;
    --type-caption: 0.6875rem;
    --type-label: 0.75rem;
    --type-body: 0.8125rem;
    --type-readable: 0.875rem;
    --type-title: 1rem;
    --type-subhead: 1.125rem;
    --type-page-title: 1.375rem;
    --type-headline: 1.75rem;
    --type-metric: 2.75rem;
    --type-display-sm: clamp(1.625rem, 4vw, 2.625rem);
    --type-display-md: clamp(1.875rem, 4.6vw, 3.375rem);
    --type-display-lg: clamp(2.125rem, 5vw, 3.625rem);
    --type-display-xl: clamp(2.625rem, 7vw, 5.25rem);
    --type-score: clamp(2.5rem, 5.4vw, 4.375rem);
    --type-score-large: clamp(2.75rem, 6vw, 4.5rem);
    --type-logo-sm: 1.625rem;
    --type-logo-md: 2.125rem;
    --type-logo-lg: clamp(3rem, 6vw, 4.75rem);
    --space-xs: 4px; --space-sm: 8px; --space-md: 12px;
    --space-lg: 16px; --space-xl: 24px; --space-xxl: 32px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      color-scheme: dark;
      --bg: #0b0d0e; --panel: #121615; --panel-soft: rgba(18, 22, 21, 0.76);
      --ink: #dedbd2; --muted: #9b968c; --soft: #706c65;
      --line: #28302d; --line-strong: #39423e;
      --accent: #ff0000; --ok: #00ff00; --warn: #0000ff; --bad: #e07a6d;
      --body-bg: linear-gradient(180deg, rgba(255, 255, 255, 0.025), transparent 280px), repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.018) 0 1px, transparent 1px 96px), var(--bg);
      --shadow: rgb(0 0 0 / 48%);
    }
  }
  :root[data-theme="light"] {
    color-scheme: light;
    --bg: #eeeeee; --panel: #f5f5f5; --panel-soft: rgba(245, 245, 245, 0.72);
    --ink: #161616; --muted: #77736d; --soft: #9a958e;
    --line: #e4e4e4; --line-strong: #d7d7d7;
    --accent: #ff0000; --ok: #00ff00; --warn: #0000ff; --bad: #b84f3f;
    --body-bg: repeating-linear-gradient(135deg, rgba(22, 22, 22, 0.018) 0 1px, transparent 1px 7px), var(--bg);
    --shadow: rgb(0 0 0 / 18%);
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --bg: #0b0d0e; --panel: #121615; --panel-soft: rgba(18, 22, 21, 0.76);
    --ink: #dedbd2; --muted: #9b968c; --soft: #706c65;
    --line: #28302d; --line-strong: #39423e;
    --accent: #ff0000; --ok: #00ff00; --warn: #0000ff; --bad: #e07a6d;
    --body-bg: linear-gradient(180deg, rgba(255, 255, 255, 0.025), transparent 280px), repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.018) 0 1px, transparent 1px 96px), var(--bg);
    --shadow: rgb(0 0 0 / 48%);
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--body-bg); color: var(--ink);
    font: var(--type-body)/1.5 var(--ui);
    -webkit-font-smoothing: antialiased;
    font-kerning: normal;
    font-optical-sizing: auto;
    font-variant-numeric: tabular-nums;
    text-rendering: geometricPrecision;
    font-feature-settings: "liga" 0, "calt" 0;
  }
  a { color: var(--accent); }
  a:hover, a:focus-visible { text-decoration-thickness: 2px; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  header.site {
    border-bottom: 1px solid var(--line); padding: var(--space-lg) var(--space-xl);
    display: flex; align-items: center; gap: var(--space-md); flex-wrap: wrap;
  }
  header.site .brand {
    display: inline-flex;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
  }
  header.site .brand svg {
    display: block;
    width: auto;
    height: 20px;
  }
  header.site .tagline { color: var(--muted); font-size: var(--type-body); }
  .theme-switch { display: inline-flex; gap: 0; margin-left: auto; border: 1px solid var(--line); }
  .theme-choice {
    min-height: 28px;
    padding: 0 10px;
    border: 0;
    border-right: 1px solid var(--line);
    border-radius: 0;
    background: var(--panel);
    color: var(--muted);
    font-family: var(--mono);
    font-size: var(--type-label);
    font-weight: 700;
  }
  .theme-choice:last-child { border-right: 0; }
  .theme-choice:hover,
  .theme-choice:focus-visible,
  .theme-choice[aria-pressed="true"] {
    color: var(--accent);
    filter: none;
  }
  main { max-width: 1320px; margin: 0 auto; padding: var(--space-xl) var(--space-lg) 64px; }
  main.scan-main {
    display: grid;
    width: 100%;
    max-width: none;
    min-height: calc(100dvh - 62px);
    padding: var(--space-lg);
    place-items: center;
  }
  h1 { font-size: var(--type-page-title); margin: 8px 0 16px; }
  h2 { font-size: var(--type-title); margin: 32px 0 8px; }
  .panel { background: var(--panel-soft); border: 1px solid var(--line); border-radius: 0; padding: var(--space-lg); }
  .muted { color: var(--muted); }
  .mono { font-family: var(--mono); font-size: var(--type-body); }
  .prose {
    max-width: 78ch;
    font-size: var(--type-readable);
    line-height: 1.62;
  }
  .text-balance { text-wrap: balance; }
  .text-pretty { text-wrap: pretty; }
  .type-caption { font-size: var(--type-caption); }
  .type-label { font-size: var(--type-label); }
  .type-body { font-size: var(--type-body); }
  .type-readable { font-size: var(--type-readable); }
  table { width: 100%; border-collapse: collapse; font-size: var(--type-readable); }
  th, td { text-align: left; padding: var(--space-sm); border-bottom: 1px solid var(--line); vertical-align: top; }
  th { color: var(--muted); font-weight: 600; font-size: var(--type-label); text-transform: uppercase; letter-spacing: .04em; }
  .chip {
    display: inline-block; padding: 1px 8px; border-radius: 2px; font-size: var(--type-label);
    border: 1px solid var(--line); color: var(--muted); white-space: nowrap;
  }
  .chip.ok { border-color: var(--ok); color: var(--ok); }
  .chip.warn { border-color: var(--warn); color: var(--warn); }
  .chip.bad { border-color: var(--bad); color: var(--bad); }
  .chip.info { border-color: var(--accent); color: var(--accent); }
  .chip.filled { font-weight: 700; }
  .chip.warn.filled { background: var(--warn); color: var(--bg); }
  .chip.bad.filled { background: var(--bad); color: var(--bg); }
  .chip.ok.filled { background: var(--ok); color: var(--bg); }
  .status-tag {
    display: inline-block;
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: 2px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: var(--type-caption);
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
  }
  .status-tag--filled { color: var(--bg); }
  .status-tag--ok.status-tag--filled { background: var(--ok); border-color: var(--ok); }
  .status-tag--warn.status-tag--filled { background: var(--warn); border-color: var(--warn); }
  .status-tag--bad.status-tag--filled { background: var(--bad); border-color: var(--bad); }
  .status-tag--info.status-tag--filled { background: var(--accent); border-color: var(--accent); }
  .status-tag--neutral.status-tag--filled {
    background: var(--line-strong);
    border-color: var(--line-strong);
  }
  input[type="url"], input[type="text"], input[type="password"], textarea {
    width: 100%; padding: 10px 12px; border: 1px solid var(--line-strong); border-radius: 0;
    background: var(--panel); color: var(--ink); font: var(--type-body)/1.5 var(--mono);
  }
  textarea { resize: vertical; }
  input:focus, textarea:focus { border-color: var(--accent); outline: 2px solid var(--accent); outline-offset: 0; }
  button {
    padding: 10px 18px; border-radius: 0; border: 1px solid var(--accent);
    background: var(--accent); color: var(--bg); font: 700 var(--type-body)/1.3 var(--mono); cursor: pointer;
    transition: filter 150ms ease;
  }
  button.secondary { background: transparent; color: var(--ink); border-color: var(--line-strong); }
  button.danger { background: transparent; color: var(--bad); border-color: var(--bad); }
  button:disabled { cursor: not-allowed; opacity: .45; filter: none; }
  button:hover { filter: brightness(1.1); }
  button:active { filter: brightness(.92); }
  .form-row {
    display: grid;
    grid-template-columns: minmax(280px, 1fr) minmax(180px, 300px) auto;
    gap: 8px;
    align-items: end;
  }
  .form-row label { min-width: 0; }
  .form-options {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--line);
  }
  .check-row {
    display: inline-flex; align-items: center; gap: 8px; min-height: 24px;
    color: var(--muted);
    font: var(--type-label)/1.35 var(--mono);
  }
  .check-row input { margin: 0; }
  .form-action { display: flex; align-items: end; }
  .form-action button {
    min-height: 41px;
    white-space: nowrap;
  }
  .page-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-lg);
    margin: 0 0 var(--space-md);
  }
  .page-head h1,
  .page-head h2 { margin: 0; }
  .page-head--section { margin-top: var(--space-xxl); }
  .page-tools {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }
  .brand-cell {
    min-width: 180px;
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    white-space: nowrap;
  }
  .brand-cell a {
    flex: 0 0 auto;
    font-weight: 700;
  }
  .brand-cell-url {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--ink);
    font-family: var(--mono);
    font-size: var(--type-caption);
  }
  .reports-table th,
  .reports-table td {
    padding-top: 12px;
    padding-bottom: 12px;
  }
  .reports-table .chip {
    padding-top: 3px;
    padding-bottom: 3px;
    line-height: 1.2;
  }
  tr[data-row-href] { cursor: pointer; }
  tr[data-row-href]:hover td { background: rgb(255 255 255 / 4%); }
  tr[data-row-href]:focus-within td { background: rgb(255 255 255 / 6%); }
  .scorebox { display: flex; gap: 24px; align-items: baseline; flex-wrap: wrap; }
  .scorebox .score { font-family: var(--mono); font-size: var(--type-metric); font-weight: 700; }
  .report-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(170px, .72fr) minmax(170px, .72fr);
    margin-top: 14px;
    margin-bottom: var(--space-xl);
    border: 1px solid var(--line);
    background: var(--panel);
  }
  .report-hero-main,
  .report-hero-metric {
    min-width: 0;
    padding: 18px;
  }
  .report-hero-main,
  .report-hero-metric:not(:last-child) {
    border-right: 1px solid var(--line);
  }
  .report-hero-title {
    margin: 0;
    font-family: var(--mono);
    font-size: var(--type-display-lg);
    line-height: .95;
  }
  .report-hero-url {
    display: inline-block;
    max-width: 100%;
    margin-top: 12px;
    overflow-wrap: anywhere;
    color: var(--muted);
    font-family: var(--mono);
    font-size: var(--type-label);
    line-height: 1.4;
    text-decoration: none;
  }
  .report-hero-url:hover,
  .report-hero-url:focus-visible { color: var(--accent); }
  .report-hero-metric {
    display: grid;
    align-content: space-between;
    min-height: 134px;
    gap: 10px;
  }
  .report-hero-label,
  .report-hero-note {
    font-family: var(--mono);
    font-size: var(--type-caption);
    line-height: 1.4;
    color: var(--muted);
  }
  .report-hero-label { text-transform: uppercase; }
  .report-hero-score {
    font-family: var(--mono);
    font-size: var(--type-score);
    font-weight: 700;
    line-height: .9;
    color: var(--accent);
  }
  .report-hero-score--gain { color: var(--ok); }
  .report-hero-score span {
    color: var(--muted);
    font-size: var(--type-body);
    font-weight: 400;
  }
  .moodboard-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(120px, 170px);
    align-items: stretch;
    margin-top: 14px;
    margin-bottom: var(--space-xl);
    border: 1px solid var(--line);
    background: var(--panel);
  }
  .moodboard-identity {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
    padding: 18px;
  }
  .moodboard-logo {
    display: grid;
    place-items: center;
    flex: 0 0 72px;
    width: 72px;
    height: 72px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--accent);
    font-family: var(--mono);
    font-size: var(--type-logo-md);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
  }
  .moodboard-logo img {
    display: block;
    width: 100%;
    height: 100%;
    padding: 8px;
    object-fit: contain;
  }
  .moodboard-meta {
    display: grid;
    gap: 8px;
    min-width: 0;
  }
  .moodboard-meta .section-head { margin: 0; }
  .moodboard-title {
    margin: 0;
    overflow-wrap: anywhere;
    font-family: var(--mono);
    font-size: var(--type-display-md);
    line-height: .95;
  }
  .moodboard-url { margin-top: 0; }
  .moodboard-asset-count {
    display: grid;
    align-content: center;
    gap: 8px;
    min-width: 0;
    padding: 18px;
    border-left: 1px solid var(--line);
  }
  .moodboard-count {
    font-family: var(--mono);
    font-size: var(--type-metric);
    font-weight: 700;
    line-height: .9;
    color: var(--accent);
  }
  .report-score-bar {
    width: 100%;
    height: 5px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--bg);
  }
  .report-score-bar span {
    display: block;
    width: var(--score-width);
    height: 100%;
    background: var(--accent);
    transform-origin: left center;
    animation: report-score-load 900ms steps(14, end) both;
  }
  @keyframes report-score-load {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; }
  .cell { border: 1px solid var(--line); border-radius: 6px; padding: 8px 10px; background: var(--panel); }
  .cell .k { font-size: var(--type-label); color: var(--muted); }
  .cell .v { font-family: var(--mono); font-size: var(--type-subhead); font-weight: 700; }
  .acquisition-trace {
    width: 100%;
    margin-top: var(--space-xxl);
  }
  .acquisition-trace h2 { margin-top: 0; }
  .acquisition-panel {
    min-width: 0;
    max-width: 100%;
    margin-bottom: var(--space-md);
    overflow: hidden;
  }
  .acquisition-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }
  .acquisition-metric {
    display: grid;
    gap: var(--space-sm);
    align-content: space-between;
    min-height: 84px;
    border-radius: 0;
  }
  .acquisition-metric .k {
    font-family: var(--mono);
    font-size: var(--type-caption);
    text-transform: uppercase;
  }
  .acquisition-metric .v {
    font-size: var(--type-page-title);
    line-height: 1;
  }
  .acquisition-artifacts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: var(--space-sm);
    min-width: 0;
  }
  .acquisition-artifacts > * { min-width: 0; }
  .acquisition-subhead {
    margin: var(--space-xl) 0 var(--space-sm);
    font-size: var(--type-readable);
  }
  .section-head { display: flex; justify-content: space-between; gap: 10px; align-items: baseline; margin-bottom: 12px; }
  .section-head .label { color: var(--accent); font-family: var(--mono); font-size: var(--type-body); font-weight: 700; text-transform: uppercase; }
  .section-head .tag { color: var(--muted); font-family: var(--mono); font-size: var(--type-caption); }
  .source-link {
    width: fit-content;
    display: inline-flex;
    min-height: 28px;
    align-items: center;
    border: 1px solid var(--line);
    padding: 3px 8px;
    background: var(--panel);
    color: var(--ink);
    font-family: var(--mono);
    font-size: var(--type-label);
    text-decoration: none;
  }
  .source-link:hover,
  .source-link:focus-visible { border-color: var(--accent); color: var(--accent); }
  .source-link-button {
    min-height: 28px;
    padding: 3px 8px;
    background: var(--panel);
    color: var(--ink);
    border-color: var(--line);
    font-size: var(--type-label);
    font-weight: 400;
  }
  .moodboard-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 12px;
    margin-top: 14px;
  }
  .moodboard-tile {
    min-width: 0;
    margin: 0;
    border: 1px solid var(--line);
    background: var(--panel);
  }
  .moodboard-tile a {
    display: grid;
    place-items: center;
    min-height: 190px;
    aspect-ratio: 4 / 3;
    padding: 12px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, .03), transparent),
      var(--bg);
  }
  .moodboard-tile img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .moodboard-tile figcaption {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding: 8px;
    border-top: 1px solid var(--line);
    overflow-wrap: anywhere;
  }
  .moodboard-reading {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 14px;
    margin-top: 14px;
  }
  .moodboard-help {
    margin-top: 10px;
    font-size: var(--type-caption);
  }
  .moodboard-stage {
    position: relative;
    min-height: clamp(420px, 62vh, 760px);
    margin-top: 14px;
    overflow: hidden;
    border: 1px solid var(--line);
    background:
      radial-gradient(circle at 50% 45%, rgba(255, 255, 255, .08), transparent 34%),
      radial-gradient(circle at 18% 18%, rgba(255, 0, 0, .13), transparent 28%),
      radial-gradient(circle at 84% 68%, rgba(0, 0, 255, .12), transparent 32%),
      #050606;
    touch-action: none;
    cursor: grab;
  }
  .moodboard-stage--brand {
    min-height: clamp(300px, 44vh, 520px);
    margin-top: 12px;
  }
  .moodboard-stage:active { cursor: grabbing; }
  .cloud-layer {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }
  .cloud-card {
    position: absolute;
    left: 0;
    top: 0;
    margin: 0;
    will-change: transform, opacity, filter;
    transition: filter 160ms ease, opacity 160ms ease;
  }
  .cloud-card-img {
    display: block;
    width: 100%;
    height: 100%;
    border: 1px solid rgba(222, 219, 210, .28);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, .12), rgba(255, 255, 255, .02)),
      #111;
    box-shadow: 0 18px 48px rgb(0 0 0 / 45%);
  }
  .cloud-card.is-filled .cloud-card-img {
    background-image:
      linear-gradient(180deg, rgba(255, 255, 255, .08), transparent),
      var(--cell-img);
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
  }
  .cloud-card.is-filled:hover .cloud-card-img {
    border-color: var(--accent);
    box-shadow:
      -3px 0 0 rgba(255, 0, 0, .65),
      3px 0 0 rgba(0, 0, 255, .55),
      0 22px 64px rgb(0 0 0 / 55%);
  }
  .moodboard-grain,
  .moodboard-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .moodboard-grain {
