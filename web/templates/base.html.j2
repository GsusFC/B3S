<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}B3S — Brand Evidence Lab{% endblock %}</title>
<script>
  (() => {
    try {
      const storedTheme = window.localStorage.getItem("b3s-theme");
      if (storedTheme === "light" || storedTheme === "dark") {
        document.documentElement.dataset.theme = storedTheme;
      }
    } catch {
      // localStorage can be unavailable in strict/private contexts.
    }
  })();
</script>
<style>
  @import url("https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap");

  :root {
    color-scheme: light;
    --bg: #eeeeee; --panel: #f5f5f5; --panel-soft: rgba(245, 245, 245, 0.72);
    --ink: #161616; --muted: #77736d; --soft: #9a958e;
    --line: #e4e4e4; --line-strong: #d7d7d7;
    --accent: #ff0000; --ok: #00ff00; --warn: #b7792b; --bad: #b84f3f;
    --body-bg: repeating-linear-gradient(135deg, rgba(22, 22, 22, 0.018) 0 1px, transparent 1px 7px), var(--bg);
    --shadow: rgb(0 0 0 / 18%);
    --ui: "JetBrains Mono", ui-monospace, monospace;
    --mono: "JetBrains Mono", ui-monospace, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      color-scheme: dark;
      --bg: #0b0d0e; --panel: #121615; --panel-soft: rgba(18, 22, 21, 0.76);
      --ink: #dedbd2; --muted: #9b968c; --soft: #706c65;
      --line: #28302d; --line-strong: #39423e;
      --accent: #ff0000; --ok: #00ff00; --warn: #e4c76d; --bad: #e07a6d;
      --body-bg: linear-gradient(180deg, rgba(255, 255, 255, 0.025), transparent 280px), repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.018) 0 1px, transparent 1px 96px), var(--bg);
      --shadow: rgb(0 0 0 / 48%);
    }
  }
  :root[data-theme="light"] {
    color-scheme: light;
    --bg: #eeeeee; --panel: #f5f5f5; --panel-soft: rgba(245, 245, 245, 0.72);
    --ink: #161616; --muted: #77736d; --soft: #9a958e;
    --line: #e4e4e4; --line-strong: #d7d7d7;
    --accent: #ff0000; --ok: #00ff00; --warn: #b7792b; --bad: #b84f3f;
    --body-bg: repeating-linear-gradient(135deg, rgba(22, 22, 22, 0.018) 0 1px, transparent 1px 7px), var(--bg);
    --shadow: rgb(0 0 0 / 18%);
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --bg: #0b0d0e; --panel: #121615; --panel-soft: rgba(18, 22, 21, 0.76);
    --ink: #dedbd2; --muted: #9b968c; --soft: #706c65;
    --line: #28302d; --line-strong: #39423e;
    --accent: #ff0000; --ok: #00ff00; --warn: #e4c76d; --bad: #e07a6d;
    --body-bg: linear-gradient(180deg, rgba(255, 255, 255, 0.025), transparent 280px), repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.018) 0 1px, transparent 1px 96px), var(--bg);
    --shadow: rgb(0 0 0 / 48%);
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--body-bg); color: var(--ink);
    font: 13px/1.5 var(--ui);
    -webkit-font-smoothing: antialiased;
    text-rendering: geometricPrecision;
    font-feature-settings: "liga" 0, "calt" 0;
  }
  a { color: var(--accent); }
  a:hover, a:focus-visible { text-decoration-thickness: 2px; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  header.site {
    border-bottom: 1px solid var(--line); padding: 16px 24px;
    display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
  }
  header.site .brand { font-family: var(--mono); font-weight: 700; font-size: 16px; color: var(--ink); text-decoration: none; }
  header.site .tagline { color: var(--muted); font-size: 13px; }
  .theme-switch { display: inline-flex; gap: 0; margin-left: auto; border: 1px solid var(--line); }
  .theme-choice {
    min-height: 28px;
    padding: 0 10px;
    border: 0;
    border-right: 1px solid var(--line);
    border-radius: 0;
    background: var(--panel);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 700;
  }
  .theme-choice:last-child { border-right: 0; }
  .theme-choice:hover,
  .theme-choice:focus-visible,
  .theme-choice[aria-pressed="true"] {
    color: var(--accent);
    filter: none;
  }
  main { max-width: 920px; margin: 0 auto; padding: 24px 16px 64px; }
  h1 { font-size: 22px; margin: 8px 0 16px; }
  h2 { font-size: 16px; margin: 32px 0 8px; }
  .panel { background: var(--panel-soft); border: 1px solid var(--line); border-radius: 0; padding: 16px; }
  .muted { color: var(--muted); }
  .mono { font-family: var(--mono); font-size: 13px; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { text-align: left; padding: 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { color: var(--muted); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
  .chip {
    display: inline-block; padding: 1px 8px; border-radius: 2px; font-size: 12px;
    border: 1px solid var(--line); color: var(--muted); white-space: nowrap;
  }
  .chip.ok { border-color: var(--ok); color: var(--ok); }
  .chip.warn { border-color: var(--warn); color: var(--warn); }
  .chip.bad { border-color: var(--bad); color: var(--bad); }
  .chip.info { border-color: var(--accent); color: var(--accent); }
  input[type="url"], input[type="text"] {
    width: 100%; padding: 10px 12px; border: 1px solid var(--line-strong); border-radius: 0;
    background: var(--panel); color: var(--ink); font: 13px/1.5 var(--mono);
  }
  input:focus { border-color: var(--accent); outline: 2px solid var(--accent); outline-offset: 0; }
  button {
    padding: 10px 18px; border-radius: 0; border: 1px solid var(--accent);
    background: var(--accent); color: var(--bg); font: 700 13px/1.3 var(--mono); cursor: pointer;
    transition: filter 150ms ease;
  }
  button:hover { filter: brightness(1.1); }
  button:active { filter: brightness(.92); }
  .form-row { display: flex; gap: 8px; flex-wrap: wrap; }
  .form-row .grow { flex: 1 1 320px; }
  .scorebox { display: flex; gap: 24px; align-items: baseline; flex-wrap: wrap; }
  .scorebox .score { font-family: var(--mono); font-size: 44px; font-weight: 700; }
  .report-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(170px, .72fr) minmax(170px, .72fr);
    margin-top: 14px;
    border: 1px solid var(--line);
    background: var(--panel);
  }
  .report-hero-main,
  .report-hero-metric {
    min-width: 0;
    padding: 18px;
  }
  .report-hero-main,
  .report-hero-metric:not(:last-child) {
    border-right: 1px solid var(--line);
  }
  .report-hero-title {
    margin: 0;
    font-family: var(--mono);
    font-size: clamp(34px, 5vw, 58px);
    line-height: .95;
  }
  .report-hero-url {
    display: inline-block;
    max-width: 100%;
    margin-top: 12px;
    overflow-wrap: anywhere;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.4;
    text-decoration: none;
  }
  .report-hero-url:hover,
  .report-hero-url:focus-visible { color: var(--accent); }
  .report-hero-metric {
    display: grid;
    align-content: space-between;
    min-height: 134px;
    gap: 10px;
  }
  .report-hero-label,
  .report-hero-note {
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.4;
    color: var(--muted);
  }
  .report-hero-label { text-transform: uppercase; }
  .report-hero-score {
    font-family: var(--mono);
    font-size: clamp(40px, 5.4vw, 70px);
    font-weight: 700;
    line-height: .9;
    color: var(--accent);
  }
  .report-hero-score--gain { color: var(--ok); }
  .report-hero-score span {
    color: var(--muted);
    font-size: 13px;
    font-weight: 400;
  }
  .report-score-bar {
    width: 100%;
    height: 5px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--bg);
  }
  .report-score-bar span {
    display: block;
    width: var(--score-width);
    height: 100%;
    background: var(--accent);
    transform-origin: left center;
    animation: report-score-load 900ms steps(14, end) both;
  }
  @keyframes report-score-load {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; }
  .cell { border: 1px solid var(--line); border-radius: 6px; padding: 8px 10px; background: var(--panel); }
  .cell .k { font-size: 12px; color: var(--muted); }
  .cell .v { font-family: var(--mono); font-size: 18px; font-weight: 700; }
  .evidence { border-left: 3px solid var(--line); padding: 4px 12px; margin: 8px 0; }
  .evidence .ref { font-family: var(--mono); font-size: 12px; color: var(--muted); overflow-wrap: anywhere; }
  ul.plain { list-style: none; padding: 0; margin: 8px 0; }
  ul.plain li { padding: 4px 0; border-bottom: 1px solid var(--line); }
  .phases li { display: flex; gap: 10px; align-items: baseline; padding: 8px 0; }
  .error { border: 1px solid var(--bad); color: var(--bad); border-radius: 6px; padding: 10px 12px; margin: 12px 0; }
  .overflow { overflow-x: auto; }
  main.wide { max-width: 1320px; }
  .canvas { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 14px; margin-top: 16px; align-items: stretch; }
  .component-card {
    min-width: 0;
    position: relative;
    border-radius: 4px;
    padding: 14px;
    font-family: var(--mono);
  }
  .component-card--muted { border-style: dashed; }
  .component-card--third { grid-column: span 2; }
  .component-card--half { grid-column: span 3; }
  .component-card--full { grid-column: 1 / -1; }
  .card-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .card-title {
    margin: 2px 0 0;
    color: var(--bad);
    font-size: 13px;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: uppercase;
  }
  .card-actions { display: flex; align-items: flex-start; justify-content: flex-end; gap: 6px; flex-wrap: wrap; }
  .badge {
    min-height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 700;
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 2px 8px;
    white-space: nowrap;
  }
  .card-result { margin: 26px 0 0; font-size: 14px; line-height: 1.55; }
  .card-result.muted { font-weight: 700; }
  .card-verdict {
    margin: 18px 0 0;
    padding-top: 14px;
    border-top: 1px dashed var(--line);
    font-size: 12px;
    line-height: 1.6;
    color: var(--muted);
  }
  .tiles { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0 0; }
  .tile {
    min-width: 36px; min-height: 30px; padding: 3px 7px; display: flex; align-items: center; justify-content: center;
    border: 1px solid var(--line); border-radius: 4px; font-family: var(--mono); font-size: 11px; font-weight: 600;
  }
  .tile.is-on { background: var(--accent); border-color: var(--accent); color: #fff; }
  .tile.is-off { background: color-mix(in srgb, var(--bad) 14%, transparent); border-color: var(--bad); color: var(--bad); }
  .tile.is-blind { background: transparent; border-style: dashed; color: var(--muted); opacity: .7; }
  .icon-button {
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 0;
    color: var(--muted);
    background: var(--panel);
    cursor: pointer;
  }
  .icon-button:hover,
  .icon-button:focus-visible { color: var(--accent); border-color: var(--accent); }
  .icon-button svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.8; }
  .report-drawer {
    width: min(620px, calc(100dvw - 24px));
    max-width: calc(100dvw - 24px);
    height: calc(100dvh - 24px);
    max-height: calc(100dvh - 24px);
    margin: 12px 12px 12px auto;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 0;
    background: var(--panel);
    color: var(--ink);
    box-shadow: -18px 0 42px var(--shadow);
    overflow: auto;
    scrollbar-width: none;
  }
  .report-drawer::-webkit-scrollbar { display: none; }
  .report-drawer::backdrop { background: rgb(0 0 0 / 42%); }
  .report-drawer-head {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 16px;
    border-bottom: 1px solid var(--line);
    background: var(--panel);
  }
  .report-drawer-head h3 {
    margin: 4px 0 0;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 28px;
    line-height: 1.2;
  }
  .report-drawer-kicker {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
  }
  .report-drawer-stack {
    display: grid;
    gap: 14px;
    padding: 14px;
  }
  .drawer-section {
    border: 1px solid var(--line);
    padding: 16px 18px;
    background: var(--panel);
    font-family: var(--mono);
  }
  .drawer-section h4 {
    margin: 0 0 14px;
    color: var(--bad);
    font-size: 13px;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .drawer-section p {
    margin: 0;
    font-size: 13px;
    line-height: 1.62;
  }
  .drawer-section p + p { margin-top: 8px; }
  .drawer-section-note {
    margin-bottom: 14px !important;
    color: var(--muted);
    font-size: 12px !important;
  }
  .drawer-summary-line {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .drawer-tiles {
    display: grid;
    gap: 10px;
  }
  .drawer-tile {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 12px;
    border: 1px solid var(--line);
    padding: 12px 14px;
    background: color-mix(in srgb, var(--bad) 8%, var(--panel));
  }
  .drawer-tile.is-off { border-color: color-mix(in srgb, var(--bad) 65%, var(--line)); }
  .drawer-tile.is-blind {
    border-style: dashed;
    background: var(--panel);
  }
  .drawer-tile-id {
    min-height: 70px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 700;
  }
  .drawer-tile-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 6px;
  }
  .drawer-tile-head strong {
    font-size: 12px;
    line-height: 1.35;
    text-transform: uppercase;
  }
  .drawer-tile-body p {
    font-size: 13px;
    line-height: 1.55;
  }
  .drawer-meta { margin: 0 0 4px; }
  @media (max-width: 980px) {
    .report-hero { grid-template-columns: 1fr 1fr; }
    .report-hero-main { grid-column: 1 / -1; border-right: 0; border-bottom: 1px solid var(--line); }
    .canvas { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .component-card--third, .component-card--half { grid-column: span 1; }
    .component-card--full { grid-column: 1 / -1; }
  }
  @media (max-width: 680px) {
    .report-hero { grid-template-columns: 1fr; }
    .report-hero-main,
    .report-hero-metric:not(:last-child) { border-right: 0; border-bottom: 1px solid var(--line); }
    .canvas { grid-template-columns: 1fr; }
    .component-card--third, .component-card--half, .component-card--full { grid-column: 1 / -1; }
    .drawer-tile { grid-template-columns: 50px minmax(0, 1fr); padding: 10px; }
    .drawer-tile-id { min-height: 54px; }
    .report-drawer-head h3 { font-size: 24px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .report-score-bar span { animation: none; }
  }
</style>
</head>
<body>
<header class="site">
  <a class="brand" href="/">B3S</a>
  <span class="tagline">brand evidence lab — every number must survive “show me the evidence”</span>
  <div class="theme-switch" aria-label="Tema">
    <button type="button" class="theme-choice" data-theme-choice="light" aria-pressed="false">Day</button>
    <button type="button" class="theme-choice" data-theme-choice="dark" aria-pressed="false">Night</button>
  </div>
</header>
<main class="{% block main_class %}{% endblock %}">
{% block content %}{% endblock %}
</main>
<script>
(() => {
  const root = document.documentElement;
  const themeButtons = [...document.querySelectorAll("[data-theme-choice]")];
  const storedTheme = window.localStorage.getItem("b3s-theme");

  function setTheme(theme) {
    if (theme === "light" || theme === "dark") {
      root.dataset.theme = theme;
      window.localStorage.setItem("b3s-theme", theme);
    }
    themeButtons.forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.themeChoice === root.dataset.theme));
    });
  }

  if (storedTheme === "light" || storedTheme === "dark") {
    setTheme(storedTheme);
  }

  themeButtons.forEach((button) => {
    button.addEventListener("click", () => setTheme(button.dataset.themeChoice));
  });

  document.querySelectorAll("[data-dialog-target]").forEach((button) => {
    button.addEventListener("click", () => {
      const dialog = document.getElementById(button.dataset.dialogTarget);
      if (!dialog) return;
      if (typeof dialog.showModal === "function") dialog.showModal();
      else dialog.setAttribute("open", "");
    });
  });

  document.querySelectorAll("dialog.report-drawer").forEach((dialog) => {
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
})();
</script>
</body>
</html>
