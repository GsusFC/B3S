{
  "timeoutMs": 5000,
  "tools": [
    {
      "name": "b3s_list_brand_analyses",
      "risk": "read-only",
      "expectedAnnotations": {
        "readOnly": true,
        "untrustedContent": true
      },
      "input": {
        "query": "__b3s_webmcp_smoke_no_match__",
        "limit": 5
      },
      "expectedOutputSubset": {
        "matched": 0,
        "analyses": []
      }
    },
    {
      "name": "b3s_get_brand_analysis",
      "risk": "read-only",
      "expectedAnnotations": {
        "readOnly": true,
        "untrustedContent": true
      }
    },
    {
      "name": "b3s_read_report_markdown",
      "risk": "read-only",
      "expectedAnnotations": {
        "readOnly": true,
        "untrustedContent": true
      }
    },
    {
      "name": "b3s_get_scan_status",
      "risk": "read-only",
      "expectedAnnotations": {
        "readOnly": true,
        "untrustedContent": true
      }
    },
    {
      "name": "b3s_prepare_scan",
      "risk": "reversible",
      "expectedAnnotations": {
        "readOnly": false,
        "untrustedContent": true
      },
      "input": {
        "url": "https://webmcp-smoke.invalid",
        "brandName": "WebMCP smoke",
        "allowDegradedFallback": false
      },
      "expectedOutputSubset": {
        "prepared": true,
        "submitted": false,
        "requiresHumanSubmit": true
      }
    },
    {
      "name": "b3s_continue_degraded_scan",
      "risk": "consequential",
      "expectedAnnotations": {
        "readOnly": false,
        "untrustedContent": true
      }
    },
    {
      "name": "b3s_cancel_scan",
      "risk": "consequential",
      "expectedAnnotations": {
        "readOnly": false,
        "untrustedContent": true
      }
    }
